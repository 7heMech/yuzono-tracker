---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  /** Wide pages (the board) vs reading pages (docs, forms). */
  narrow?: boolean;
}

const {
  title,
  description = 'Which anime extension sources are broken, and which ones the community wants most.',
  narrow = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · yuzono tracker</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      Preload only the subsets that are actually painted.

      Unfiltered `preload` emits a link for every generated file, which meant
      IBM Plex Sans' `latin-ext` (25,868 bytes) was fetched at highest priority
      on every page to render nothing: the only non-ASCII characters in the 310
      source names are one "ü" — U+00FC, inside the `latin` subset's range —
      plus Arabic and Chinese, which neither subset covers and which the system
      fallback has to draw regardless. Left unpreloaded it would still be there
      for anyone whose report text needs it, fetched on demand by unicode-range.

      IBM Plex Mono was not preloaded at all, and it carries every number on
      the board through --font-data, so the counts visibly reflowed. It is
      preloaded at 400 and 600 — the vote counts are 600, everything else is
      400 — and not at 500, which appears only inside the search islands that
      hydrate later anyway. Sans is preloaded across all three weights because
      Google serves it as one variable file, so those three links resolve to a
      single 40 KB request.
    */}
    <Font cssVariable="--font-ui-family" preload={[{ subset: 'latin' }]} />
    <Font
      cssVariable="--font-data-family"
      preload={[
        { subset: 'latin', weight: 400 },
        { subset: 'latin', weight: 600 },
      ]}
    />

    {/*
      The theme is resolved before first paint and the toggle is wired up by
      src/scripts/theme.js, injected at Astro's `head-inline` stage from
      astro.config.mjs. It is not an `is:inline` script here on purpose: the CSP
      Astro generates hashes injected scripts and not inline ones, so keeping it
      in this file would have shipped a policy that blocked it.
    */}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['shell', { prose: narrow }]}>
      <slot />
    </main>

    <footer class="shell foot">
      <p>
        Community-run tracker for <a href="https://github.com/yuzono/anime-extensions">yuzono/anime-extensions</a>.
        Not affiliated with the extension maintainers.
      </p>
    </footer>

    <style>
      main {
        padding-block: var(--space-6) var(--space-16);
      }
      main.prose {
        max-inline-size: var(--measure-prose);
      }
      .foot {
        padding-block: var(--space-6);
        border-block-start: 1px solid var(--border-subtle);
        font-size: var(--text-sm);
        color: var(--text-muted);
      }
      .foot a {
        color: var(--text-tertiary);
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 2px;
      }
      .foot a:hover {
        color: var(--text-secondary);
      }
    </style>

  </body>
</html>
