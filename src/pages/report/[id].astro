---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import VoteButton from '../../components/VoteButton.astro';
import { and, eq, isNull, sql } from 'drizzle-orm';
import { db } from '../../lib/db/client';
import { OPEN_STATUSES, reports, votes } from '../../lib/db/schema';
import { avatarUrl, currentUser, dbUser } from '../../lib/auth';
import { reporterMeta } from '../../lib/reporter';
import { atLeast } from '../../lib/levels';
import { isResponse, levelOf, logAction, requireStaff } from '../../lib/staff';
import { announceFixed } from '../../lib/webhook';
import { notifyWatchers } from '../../lib/notify';
import { promoteUrl } from '../../lib/github';
import { getSource, langLabel, sourcePath } from '../../lib/sources';
import {
  CAUSE_LABELS,
  KIND_LABELS,
  relativeAge,
  reportHeadline,
  STAGE_FAILURE,
  STATUS_LABELS,
} from '../../lib/format';
import { STATUSES } from '../../lib/db/schema';
import { isOutdated } from '../../lib/version';

export const prerender = false;

/* Read in two places — the POST branch above the page body, and the issue
   link below it — so it is a function rather than a const declared after both. */
const repoName = () => String(env.GITHUB_REPO ?? 'yuzono/anime-extensions');

const id = Number(Astro.params.id);
/* A non-numeric id is a broken pasted link, so it gets the page that explains
   itself and offers the finder rather than being tipped onto the board with no
   idea why. Rewrite, not redirect, so the bad URL stays visible in the bar. */
if (!Number.isInteger(id)) return Astro.rewrite('/404');

/* Moderator actions. Authorisation is re-read from D1 here rather than taken
   from the session, so a revoked moderator loses this immediately instead of
   when they next sign in.

   One form, two fields: a status button submits `status`, the 18+ button
   submits `nsfw`, and only the button that was pressed is sent. That keeps a
   single POST handler behind a single `requireStaff` gate. */
if (Astro.request.method === 'POST') {
  const gate = await requireStaff(Astro, 'mod');
  if (isResponse(gate)) return gate;

  const form = await Astro.request.formData();
  const wanted = String(form.get('status') ?? '');
  const nsfwWanted = form.get('nsfw');

  if ((STATUSES as readonly string[]).includes(wanted)) {
    const status = wanted as (typeof STATUSES)[number];
    const rawNote = String(form.get('note') ?? '').trim().slice(0, 500);
    const statusNote = rawNote || null;
    // status_changed detail is "status: note" — me.astro splits on first colon and validates the status
    const detail = statusNote ? `${status}: ${statusNote}` : status;
    const [updated] = await db()
      .update(reports)
      .set({ status, statusNote, statusChangedAt: sql`(unixepoch())`, updatedAt: sql`(unixepoch())` })
      .where(eq(reports.id, id))
      .returning();
    if (updated) {
      await logAction(gate.user, 'report.status', String(id), detail);

      /* Two side effects, neither of which the moderator should wait for: the
         Discord post costs 200-500ms of somebody else's network, and the
         notification fan-out is a write nobody is watching. Announcing is
         `after` work; the redirect is the answer.

         Notifications are the loop this project exists to close — a Discord
         announcement is a broadcast and cannot say which fix was *yours*, so
         the reporter and everyone who backed the report each get a row they can
         read on /me. */
      const after: Promise<unknown>[] = [
        notifyWatchers(id, 'status_changed', detail, gate.user.id),
      ];
      if (status === 'fixed') after.push(announceFixed(updated, Astro.url.origin));

      // waitUntil on Workers, await when there is no Cloudflare context —
      // which is what keeps `astro dev` working. Same shape as /vote.
      const cf = Astro.locals.cfContext;
      if (cf) for (const task of after) cf.waitUntil(task);
      else await Promise.all(after);
    }
    return Astro.redirect(`/report/${id}?saved=status`, 303);
  }

  /* Promotion. A prefilled issue form rather than the API, because this install
     holds no GitHub token — see lib/github.ts. The claim below is the point of
     `promoted_at`: opening an issue upstream cannot be undone, so a double-tap
     has to be refused by the database rather than by hoping it does not happen.
     Same shape as the announcement claims in lib/webhook.ts. */
  if (form.get('promote') === '1') {
    const [claimed] = await db()
      .update(reports)
      .set({ promotedAt: sql`(unixepoch())`, updatedAt: sql`(unixepoch())` })
      .where(and(eq(reports.id, id), isNull(reports.promotedAt), isNull(reports.githubIssue)))
      .returning();
    if (!claimed) return Astro.redirect(`/report/${id}?saved=promote-already`, 303);

    /* Confirmed, not in_progress: sending it upstream says a moderator believes
       it, which is what `confirmed` means. Claiming work has started would be a
       stronger statement than anyone has made. */
    await db()
      .update(reports)
      .set({ status: 'confirmed', statusChangedAt: sql`(unixepoch())` })
      .where(and(eq(reports.id, id), sql`${reports.status} <> 'confirmed'`));
    await logAction(gate.user, 'report.promote', String(id), null);

    /* The kind already declared on notifications, unused until now. Watchers
       hear that their report went upstream, which is the whole point of the
       loop: a Discord broadcast cannot tell someone it was *theirs*. */
    const promoted = notifyWatchers(id, 'promoted', null, gate.user.id);
    const cf = Astro.locals.cfContext;
    if (cf) cf.waitUntil(promoted);
    else await promoted;

    /* Straight to the prefilled form. The issue number comes back on its own:
       the next sync pass finds the backlink this URL plants in the body and
       links it, so nobody pastes a number back by hand. */
    return Astro.redirect(promoteUrl(claimed, repoName(), Astro.url.origin), 303);
  }

  if (nsfwWanted === '0' || nsfwWanted === '1') {
    const nsfw = nsfwWanted === '1';
    /* Only on a source request. A report against a catalogue source inherits
       `nsfw` from the catalogue, so editing it here would be overwritten by
       the next sync and would disagree with the source page — the same rule
       as `isRequest` below. */
    const [updated] = await db()
      .update(reports)
      .set({ nsfw, updatedAt: sql`(unixepoch())` })
      .where(and(eq(reports.id, id), eq(reports.kind, 'request')))
      .returning({ id: reports.id });
    if (updated) await logAction(gate.user, 'report.nsfw', String(id), nsfw ? 'on' : 'off');
    return Astro.redirect(`/report/${id}?saved=${nsfw ? 'nsfw-on' : 'nsfw-off'}`, 303);
  }

  return Astro.redirect(`/report/${id}`, 303);
}

const [report] = await db().select().from(reports).where(eq(reports.id, id));
/* Report ids get pasted into Discord and outlive the report, so a miss lands
   on the real 404 page — header, theme and the source finder — instead of a
   bare text/plain body with no way back. /404 sets the 404 status itself,
   because a rewrite resets it to 200. */
if (!report) return Astro.rewrite('/404');

const [user, reporter] = await Promise.all([currentUser(Astro), dbUser(report.reporterId)]);
// Display-only: the POST above is what actually decides.
const canModerate = user ? atLeast(await levelOf(user.id), 'mod') : false;
const mine = user
  ? (
      await db()
        .select({ r: votes.reportId })
        .from(votes)
        .where(and(eq(votes.reportId, id), eq(votes.discordId, user.id)))
    ).length > 0
  : false;

const source = getSource(report.sourceId);
const joined = Astro.url.searchParams.has('joined');
const filed = Astro.url.searchParams.has('filed');
const saved = Astro.url.searchParams.get('saved');

/* Imported reports are titled in raw HTTP jargon ("Error 404 (Search)"), so
   lead with the plain-language phrasing everywhere the title is read — and
   keep the stored one in the facts below, where a maintainer cross-referencing
   the GitHub issue can still find it verbatim. */
const headline = reportHeadline(report);

/* A source request is the only report whose 18+ flag lives on the row: for
   everything else the catalogue owns it, which is now enforced rather than
   merely intended — reconcileNsfw in lib/github-sync.ts re-derives it from the
   catalogue on every sync pass, so an edit here to a catalogue-backed row would
   genuinely be overwritten. The moderator control below is gated to
   catalogue-less rows for that reason.

   Keyed on the kind rather than on `proposed_name` being set: three of the
   imported feature requests carry a proposed_name too (the import could not
   match their source), and for those the panel offered to re-flag a row whose
   hint talks about "18+ requests" and a requester who ticked a box that was
   never on screen. */
const isRequest = report.kind === 'request';

/* Said in words, and only where the rest of the page would not say it. A
   feature request has no stage, no cause and no address, so without this the
   page shows a source name, a sentence and three facts, and never mentions that
   what it is looking at is somebody asking for something. */
const askKind = report.kind === 'feature' ? KIND_LABELS.feature : null;

/* Whether to warn a visitor, and on whose authority. The catalogue answers for
   a source that exists; a request has only what the person filing it ticked,
   which a moderator can correct. Shown to everyone, not just moderators: report
   links get pasted into Discord and outlive the report, and until now the page
   they land on said nothing at all — report 126 was about hanime.tv and read
   like any other. */
const adult = source ? source.nsfw : report.nsfw;

// The repo is configuration, not a constant — a fork points GITHUB_REPO at its
// own issues rather than sending its visitors to this one.
const repo = repoName();

/* This route shipped no cache headers at all, which is what made prefetching it
   from the board so expensive — 60 links on the homepage, every one of them a
   full Worker invocation and a D1 read. Anonymous renders are identical for
   everyone and can be held briefly; a signed-in one carries `mine` and the
   moderator controls, so it must never be stored anywhere. */
Astro.response.headers.set(
  'Cache-Control',
  user ? 'private, no-store' : 'public, max-age=0, s-maxage=30, stale-while-revalidate=120',
);
---

<Base title={`${source?.name ?? report.proposedName ?? 'Report'}: ${headline}`} narrow>
  {
    saved && (
      <p class="flash" role="status">
        {saved === 'nsfw-on'
          ? 'Marked 18+. It now shows only when 18+ is on.'
          : saved === 'nsfw-off'
            ? 'No longer marked 18+.'
            : saved === 'promote-already'
              ? 'This one has already been sent to GitHub.'
              : 'Status updated.'}
      </p>
    )
  }
  {
    (joined || filed) && (
      <p class="flash" role="status">
        {joined
          ? `Someone had already reported this. You've been added to it, so it now speaks for ${report.votes} people.`
          : "Filed. You're the first to report this one."}
      </p>
    )
  }

  {
    adult && (
      <p class="adult">
        {source
          ? 'This source is marked 18+ in the extension catalogue.'
          : 'Whoever asked for this site marked it 18+.'}{' '}
        <span class="adult-why">
          Reports on 18+ sources are hidden from the boards unless a visitor asks
          for them.
        </span>
      </p>
    )
  }

  <article>
    <header class="head">
      {/* Same rule as the row: /vote refuses a closed report, so the button
          would be a control that does nothing. */}
      <VoteButton
        reportId={report.id}
        votes={report.votes}
        mine={mine}
        closed={!(OPEN_STATUSES as readonly string[]).includes(report.status)}
      />
      <div>
        <h1>{headline}</h1>
        <p class="on">
          on{' '}
          {source ? (
            <a href={sourcePath(source)}>{source.name}</a>
          ) : (
            <span>{report.proposedName ?? 'an unknown source'}</span>
          )}
          <span class="by"> · filed by </span>
          {report.reporterId === '0' ? (
            <span>imported from GitHub</span>
          ) : report.reporterId === 'github' ? (
            report.githubIssue ? (
              <a href={`https://github.com/${repo}/issues/${report.githubIssue}`} rel="noopener noreferrer">opened on GitHub</a>
            ) : (
              <span>opened on GitHub</span>
            )
          ) : (
            <span class="filed-by">
              {(() => {
                const a = reporter ? avatarUrl({ id: reporter.discordId, avatarHash: reporter.avatarHash }, 20) : null;
                return a ? (
                  <img class="avatar" src={a} alt="" width="20" height="20" />
                ) : (
                  <span class="avatar avatar-blank" aria-hidden="true" />
                );
              })()}
              <span>{reporterMeta(report.reporterId, reporter).display}</span>
            </span>
          )}
        </p>
      </div>
    </header>

    <dl class="facts">
      <div>
        <dt class="label">Status</dt>
        <dd class="status" data-status={report.status}>{STATUS_LABELS[report.status]}</dd>
      </div>
      {report.statusNote && (
        <div class="wide"><dt class="label">Note</dt><dd>{report.statusNote}</dd></div>
      )}
      {askKind && (
        <div><dt class="label">Kind</dt><dd>{askKind} request</dd></div>
      )}
      {
        /* The address is the request. Until now the page named the site and
           never said which site it meant — two sites share a name often
           enough, and a maintainer deciding whether to build a source has
           nothing to look at without it. Only requests carry `proposed_url`;
           `new_url` below is the different fact a domain-change report
           carries. */
        report.proposedUrl && (
          <div class="wide">
            <dt class="label">Address</dt>
            <dd>
              <a
                class="new-url"
                href={report.proposedUrl}
                rel="nofollow noopener noreferrer external">
                {report.proposedUrl.replace(/^https?:\/\//, '')}
              </a>
            </dd>
          </div>
        )
      }
      {report.stage && (
        <div><dt class="label">Fails at</dt><dd>{STAGE_FAILURE[report.stage]}</dd></div>
      )}
      {report.cause && (
        <div><dt class="label">Cause</dt><dd>{CAUSE_LABELS[report.cause]}</dd></div>
      )}
      {report.newUrl && (
        <div class="wide">
          <dt class="label">New address</dt>
          <dd>
            <a class="new-url" href={report.newUrl} rel="nofollow noopener noreferrer external">
              {report.newUrl.replace(/^https?:\/\//, '')}
            </a>
          </dd>
        </div>
      )}
      <div><dt class="label">Language</dt><dd>{langLabel(report.lang)}</dd></div>
      {report.extVersion && (
        <div>
          <dt class="label">Extension</dt>
          <dd class="num">
            v{report.extVersion}
            {source && isOutdated(report.extVersion, source.extVersion) && (
              <span class="behind"> · v{source.extVersion} is current</span>
            )}
          </dd>
        </div>
      )}
      {report.appName && (
        <div>
          <dt class="label">App</dt>
          <dd>{report.appName}{report.appVersion && <span class="num"> {report.appVersion}</span>}</dd>
        </div>
      )}
      <div><dt class="label">Reported</dt><dd>{relativeAge(report.createdAt)} ago</dd></div>
      {
        /* Only when the heading is no longer the stored title. This is the
           wording on the GitHub issue, so a maintainer cross-referencing needs
           it verbatim — last and full-width, since imported titles are long. */
        headline !== report.title && (
          <div class="wide">
            <dt class="label">Filed as</dt>
            <dd class="raw">{report.title}</dd>
          </div>
        )
      }
    </dl>

    {report.body && <div class="body"><p>{report.body}</p></div>}

    {
      canModerate && (
        <form method="POST" class="mod">
          <p class="mod-label">Move this report</p>
          <div class="field">
            <label class="label" for="note">Reason</label>
            <textarea id="note" name="note" class="textarea" rows="2" maxlength="500" placeholder="Optional — shown on the report and in notifications"></textarea>
          </div>
          <div class="mod-row">
            {STATUSES.filter((st) => st !== report.status).map((st) => (
              <button class="btn" type="submit" name="status" value={st}>
                {STATUS_LABELS[st]}
              </button>
            ))}
          </div>
          <p class="mod-hint">
            Marking it fixed announces it to Discord if a webhook is set, once.
          </p>

          {!report.githubIssue && (
            <div class="mod-extra">
              <p class="mod-label">GitHub</p>
              <div class="mod-row">
                <button class="btn" type="submit" name="promote" value="1">
                  Open a GitHub issue
                </button>
              </div>
              <p class="mod-hint">
                Takes you to the issue form with the details filled in. Submit it
                there and this report finds the issue and links itself. You don't
                need to come back and paste the number in.
              </p>
            </div>
          )}

          {isRequest && (
            <div class="mod-extra">
              <p class="mod-label">Audience</p>
              <div class="mod-row">
                <button class="btn" type="submit" name="nsfw" value={report.nsfw ? '0' : '1'}>
                  {report.nsfw ? 'Not 18+ after all' : 'Mark 18+'}
                </button>
              </div>
              <p class="mod-hint">
                {report.nsfw
                  ? 'Currently hidden unless a visitor turns 18+ on.'
                  : 'The requester ticked this themselves. 18+ requests are hidden until a visitor asks for them.'}
              </p>
            </div>
          )}
        </form>
      )
    }

    {report.githubIssue && (
      <p class="gh">
        Tracked on GitHub as{' '}
        <a
          href={`https://github.com/${repo}/issues/${report.githubIssue}`}
          rel="noopener noreferrer">
          #{report.githubIssue}
        </a>
      </p>
    )}
  </article>
</Base>

<style>
  /* Same shape as the notice on a source page, so the two surfaces agree about
     what an 18+ warning looks like. A quiet box with a coloured edge and plain
     words in it, not a badge to decode. */
  .adult {
    padding: var(--space-2) var(--space-3);
    margin-block-end: var(--space-5);
    border: 1px solid var(--border-default);
    border-inline-start: 2px solid var(--dead);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .adult-why { color: var(--text-tertiary); }

  .flash {
    padding: var(--space-3);
    margin-block-end: var(--space-6);
    border: 1px solid var(--border-default);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius-md);
    background: var(--signal-fill);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  .head { display: flex; align-items: flex-start; gap: var(--space-4); }
  h1 { font-size: var(--text-xl); letter-spacing: var(--track-tight); }
  .on { margin-block-start: var(--space-1); color: var(--text-tertiary); font-size: var(--text-sm); }
  .on a { color: var(--text-secondary); text-decoration: underline; text-underline-offset: 2px; }
  .on a:hover { color: var(--signal-ink); }
  .filed-by { display: inline-flex; align-items: center; gap: var(--space-1); vertical-align: middle; }
  .filed-by .avatar, .filed-by .avatar-blank { inline-size: 20px; block-size: 20px; }

  .facts {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-block: var(--space-5);
    margin-block: var(--space-5);
    border-block: 1px solid var(--border-subtle);
  }
  .facts dd { margin-block-start: 2px; font-size: var(--text-sm); }
  /* The actionable fact on a domain-change report, so give it its own line. */
  .facts .wide { flex-basis: 100%; }
  .new-url {
    font-family: var(--font-data);
    color: var(--signal-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* Verbatim, so it reads as quoted data rather than as the page's own words —
     it is the string to search for on GitHub, character for character. */
  .raw {
    font-family: var(--font-data);
    color: var(--text-tertiary);
    overflow-wrap: anywhere;
  }
  /* The report was filed on a version that has since moved on — worth saying,
     not worth shouting, since it was current when it was filed. */
  .behind { color: var(--text-muted); font-family: var(--font-ui); }
  .body p { color: var(--text-secondary); white-space: pre-wrap; }
  .mod {
    margin-block-start: var(--space-6);
    padding: var(--space-3);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface-inset);
  }
  .mod-label { font-size: var(--text-sm); font-weight: var(--weight-medium); }
  .mod-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-block: var(--space-2);
  }
  .mod .field { margin-block: var(--space-2); }
  .mod .textarea { min-block-size: 0; }
  .mod-hint { font-size: var(--text-sm); color: var(--text-muted); }
  /* Same panel, second control: a rule keeps it from reading as another
     status, which is the one thing it must not be mistaken for. */
  .mod-extra {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--border-subtle);
  }

  .gh { margin-block-start: var(--space-6); font-size: var(--text-sm); color: var(--text-tertiary); }
  .gh a { font-family: var(--font-data); color: var(--signal-ink); text-decoration: underline; }
</style>
