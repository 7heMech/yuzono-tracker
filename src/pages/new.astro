---
import Base from '../layouts/Base.astro';
import ReportForm from '../components/ReportForm.svelte';
import { and, eq, inArray, sql } from 'drizzle-orm';
import { db } from '../lib/db/client';
import { OPEN_STATUSES, reports } from '../lib/db/schema';
import { canWriteNow, currentUser } from '../lib/auth';
import { ensureVote } from '../lib/vote';
import { getSource, langLabel, SOURCES } from '../lib/sources';
import { normaliseUrl, problemByKey, problemNeedsDetail, problemNeedsUrl, PROBLEMS } from '../lib/problems';
import { APP_OTHER, isOutdated } from '../lib/version';
import { FILING_COOLDOWN_MESSAGE, overFilingLimit } from '../lib/writes';

export const prerender = false;

// Requests have their own page: there is no extension to be out of date and
// nothing to pick from the catalogue, so none of this form applies. Old
// ?kind=request links (and the ones in the wild) keep working.
if (Astro.url.searchParams.get('kind') === 'request') {
  const to = new URL('/request', Astro.url);
  const wanted = Astro.url.searchParams.get('name');
  if (wanted) to.searchParams.set('name', wanted);
  return Astro.redirect(to.pathname + to.search, 302);
}

const user = await currentUser(Astro);

let error: string | null = null;
let openCard: string | null = null;
let resumed = false;

type Draft = {
  sourceId: string;
  problem: string;
  newUrl: string;
  detail: string;
  appName: string;
  appVersion: string;
  extVersion: string;
};

/**
 * What this POST actually submitted, kept for the render.
 *
 * Every validation branch below falls through to the page instead of
 * redirecting, and the props used to be read only from the session draft —
 * which exists solely on the anonymous path. So a signed-in person who got any
 * error at all was handed a blank form: source unpicked, both version numbers
 * gone, their description gone. Five of the six branches are reachable that
 * way, which made the commonest outcome of a mistake "type it all again".
 */
let posted: Draft | null = null;

/* ---------------------------------------------------------------------------
   POST. Order matters: cheap structural checks, then the staleness gate, then
   the problem-specific field. A stale extension is rejected before anything
   else because it is the most common non-bug and the answer is "update", not
   "we'll look into it".
   ------------------------------------------------------------------------ */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const sourceId = String(form.get('source') ?? '').trim();
  const problem = problemByKey(String(form.get('problem') ?? ''));
  const appChoice = String(form.get('appName') ?? '').trim();
  const appName =
    appChoice === APP_OTHER ? String(form.get('appNameOther') ?? '').trim().slice(0, 48) : appChoice;
  const appVersion = String(form.get('appVersion') ?? '').trim().slice(0, 32);
  const extVersion = String(form.get('extVersion') ?? '').trim().slice(0, 32);
  const detail = String(form.get('problemDetail') ?? '').trim().slice(0, 2000);
  // Capped like every other field, because it is stashed in the session on the
  // anonymous path before anything has validated it.
  const rawNewUrl = String(form.get('newUrl') ?? '').slice(0, 200);
  const source = getSource(sourceId);

  const submitted: Draft = {
    sourceId,
    problem: problem?.key ?? '',
    newUrl: rawNewUrl,
    detail,
    appName,
    appVersion,
    extVersion,
  };

  if (!user) {
    // Stash server-side so the draft survives the OAuth round trip whatever
    // its length, and never lands in a URL or a log.
    Astro.session?.set('pending_report', submitted);
    return Astro.redirect('/auth/discord?next=/new', 302);
  }
  // Re-derived on every write rather than read off the session: see canWriteNow
  // in lib/auth. `user.canWrite` was decided at login and never revisited, so a
  // banned account kept filing until it happened to sign in again.
  if (!(await canWriteNow(user))) return Astro.redirect('/cant-post', 302);

  posted = submitted;

  let newUrl: string | null = null;

  if (!source) {
    error = 'Pick which source this is about first.';
  } else if (appChoice === APP_OTHER && appName.length < 2) {
    error = 'Type the name of the app you use.';
  } else if (!appName || !appVersion || !extVersion) {
    error = 'Fill in your app and version — a report without them can rarely be acted on.';
  } else if (isOutdated(extVersion, source.extVersion)) {
    error =
      `You're on ${source.name} v${extVersion} and v${source.extVersion} is out. ` +
      `Update the extension first (Browse → Extensions → Update) — most breakage is ` +
      `already fixed in the current version. If it still fails after updating, report it then.`;
  } else if (problem && problemNeedsUrl(problem)) {
    newUrl = normaliseUrl(rawNewUrl);
    if (!newUrl) {
      error = rawNewUrl.trim()
        ? "That doesn't look like a web address. Paste the full link, e.g. https://example.com"
        : 'Add the new address so a maintainer knows where the site moved to.';
    }
  } else if (problem && problemNeedsDetail(problem) && detail.length < 10) {
    error = "Describe what happens — 'something else' needs a sentence to be actionable.";
  }

  // Whatever went wrong, reopen the card the person was typing into — the two
  // cards that carry a field are closed by default, so a collapsed one hides
  // the address or the description they just wrote.
  if (error && problem && (problemNeedsUrl(problem) || problemNeedsDetail(problem))) {
    openCard = problem.key;
  }

  if (source && problem && !error) {
    // Remember the setup so the next report is two taps again.
    Astro.session?.set('setup', { appName, appVersion });

    const d = db();
    /* The dedupe key is the *problem*, not the kind. Five of the seven problems
       are kind 'bug', so matching on kind alone meant that reporting "No
       episodes listed" on a source with an open "Blocked before it loads" sent
       you to *their* report, told you that you had been added to it, and never
       recorded your problem at all — while the unique index made filing the
       second one impossible. These three columns are exactly the columns of
       reports_open_per_source_problem, and they have to stay that way: the
       insert below relies on this select having found anything it would
       collide with. */
    const [existing] = await d
      .select({ id: reports.id, newUrl: reports.newUrl })
      .from(reports)
      .where(
        and(
          eq(reports.sourceId, sourceId),
          eq(reports.kind, problem.kind),
          eq(reports.problem, problem.key),
          inArray(reports.status, [...OPEN_STATUSES]),
        ),
      );

    if (existing) {
      // Filing again upvotes. A new address is still news, so record it if the
      // existing report never had one.
      await ensureVote(existing.id, user.id);
      if (newUrl && !existing.newUrl) {
        await d
          .update(reports)
          .set({ newUrl, updatedAt: sql`(unixepoch())` })
          .where(eq(reports.id, existing.id));
      }
      return Astro.redirect(`/report/${existing.id}?joined=1`, 303);
    }

    /* Checked here rather than at the top of the POST, because joining an
       existing report is a vote and votes are already bounded by the vote row.
       Only an insert is worth rationing. */
    if (await overFilingLimit(user.id)) {
      error = FILING_COOLDOWN_MESSAGE;
    }
  }

  if (source && problem && !error) {
    const d = db();
    const [created] = await d
      .insert(reports)
      .values({
        kind: problem.kind,
        sourceId,
        lang: source.lang,
        nsfw: source.nsfw,
        stage: problem.stage,
        cause: problem.cause,
        problem: problem.key,
        title: newUrl ? `Moved to ${new URL(newUrl).host}` : problem.label,
        body: detail || null,
        newUrl,
        reporterId: user.id,
        extVersion,
        appName,
        appVersion,
        // No `votes: 1` seed. ensureVote below inserts the vote row and moves
        // the counter in one batch, so seeding it here counted the reporter
        // twice — every new report opened claiming two people and one voter.
      })
      .returning({ id: reports.id });

    if (created) {
      await ensureVote(created.id, user.id);
      return Astro.redirect(`/report/${created.id}?filed=1`, 303);
    }
  }
}

/* --- GET ---------------------------------------------------------------- */
const draft = (await Astro.session?.get('pending_report')) as Draft | undefined;
if (draft) {
  Astro.session?.delete('pending_report');
  resumed = true;
  if (draft.problem) openCard = draft.problem;
}
const setup = (await Astro.session?.get('setup')) as
  | { appName: string; appVersion: string }
  | undefined;

/**
 * One place decides what the form shows, in priority order: what this POST just
 * submitted (an error fell through to the render), then a draft restored from
 * the sign-in detour, then the remembered setup, then the query string, then
 * nothing. Reading only from `draft` was the bug: `draft` exists solely on the
 * anonymous path, so a signed-in person who hit any validation error got a
 * blank form back and retyped everything.
 */
const shown = {
  sourceId: posted?.sourceId || draft?.sourceId || Astro.url.searchParams.get('source') || '',
  detail: posted?.detail ?? draft?.detail ?? '',
  newUrl: posted?.newUrl ?? draft?.newUrl ?? '',
  appName: posted?.appName || draft?.appName || setup?.appName || '',
  appVersion: posted?.appVersion || draft?.appVersion || setup?.appVersion || '',
  extVersion: posted?.extVersion || draft?.extVersion || '',
};

const preselected = getSource(shown.sourceId);

const formRows = SOURCES.map((s) => ({
  id: s.id,
  name: s.name,
  lang: s.lang,
  nsfw: s.nsfw,
  extName: s.extName,
  extVersion: s.extVersion,
}));
const langLabels = Object.fromEntries(
  [...new Set(SOURCES.map((s) => s.lang))].map((c) => [c, langLabel(c)]),
);
---

<Base title="Report a problem" narrow>
  <h1>Report a problem</h1>
  <p class="lede">Find your source, confirm your versions, tap what's wrong.</p>

  {
    !user && (
      <p class="note">
        You'll be asked to sign in with Discord when you tap — your draft is kept.
      </p>
    )
  }

  <form method="POST" class="flow">
    {
      resumed && !error && (
        <p class="note" role="status">
          Welcome back — your draft is still here. Tap the problem again to send it.
        </p>
      )
    }

    {error && <p class="error" role="alert">{error}</p>}

    <ReportForm
      sources={formRows}
      langLabels={langLabels}
      selectedId={preselected?.id ?? ''}
      selectedName={preselected?.name ?? ''}
      appName={shown.appName}
      appVersion={shown.appVersion}
      extVersion={shown.extVersion}
      client:load
    />

    <section class="step">
      <h2 class="step-h"><span class="step-n">3</span> What's wrong?</h2>
      {/* Revealed by ReportForm once it knows no source is picked, so it stays
          hidden with JavaScript off — where the buttons still work and the
          server does the refusing. Said in words rather than by dimming
          something and leaving the reason to be guessed. */}
      <p class="needs-source" role="status">Pick your source first.</p>
      <ul class="problems">
        {
          PROBLEMS.map((p) => {
            const needsUrl = problemNeedsUrl(p);
            const needsDetail = problemNeedsDetail(p);
            if (!needsUrl && !needsDetail) {
              return (
                <li>
                  <button class="problem" type="submit" name="problem" value={p.key}>
                    <span class="problem-label">{p.label}</span>
                    <span class="problem-hint">{p.hint}</span>
                  </button>
                </li>
              );
            }
            return (
              <li class="wide">
                {/* Native disclosure: the extra field costs no JavaScript and
                    no second page. */}
                <details class="problem problem-open" open={openCard === p.key}>
                  <summary>
                    <span class="problem-label">{p.label}</span>
                    <span class="problem-hint">{p.hint}</span>
                  </summary>
                  {needsUrl ? (
                    <div class="card-body">
                      <div class="row-2">
                        <label class="sr-only" for="newUrl">New address</label>
                        <input
                          class="input"
                          id="newUrl"
                          name="newUrl"
                          type="url"
                          inputmode="url"
                          autocomplete="off"
                          spellcheck="false"
                          value={shown.newUrl}
                          placeholder="new-address.com"
                        />
                        <button class="btn btn-primary" type="submit" name="problem" value={p.key}>
                          Send
                        </button>
                      </div>
                      <p class="field-hint">
                        Paste the address you were redirected to. Just the domain is fine.
                      </p>
                    </div>
                  ) : (
                    <div class="card-body">
                      <label class="sr-only" for="problemDetail">What happens</label>
                      <textarea
                        class="textarea"
                        id="problemDetail"
                        name="problemDetail"
                        rows="3"
                        placeholder="e.g. Episode 5 plays episode 3 instead, or subtitles are out of sync"
                        >{shown.detail}</textarea
                      >
                      <div class="row-2 end">
                        <p class="field-hint">One or two sentences is plenty.</p>
                        <button class="btn btn-primary" type="submit" name="problem" value={p.key}>
                          Send
                        </button>
                      </div>
                    </div>
                  )}
                </details>
              </li>
            );
          })
        }
      </ul>
    </section>

  </form>

  <p class="foot-note">
    Already reported by someone else? Tapping a problem adds you to their report
    instead of making a duplicate.
  </p>
</Base>

<style>
  /* Only shown when ReportForm has actually determined that no source is
     picked — never on a JavaScript-free render, where the buttons are live. */
  .needs-source {
    display: none;
    margin-block-end: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  form[data-needs-source] .needs-source { display: block; }
  form[data-needs-source] .problem { opacity: 0.55; }
  form[data-needs-source] button.problem { cursor: not-allowed; }

  h1 { font-size: var(--text-xl); }
  .lede { color: var(--text-tertiary); margin-block: var(--space-1) var(--space-6); }
  .note {
    margin-block-end: var(--space-6);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-default);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .error {
    padding: var(--space-3);
    border: 1px solid var(--dead);
    border-inline-start-width: 2px;
    border-radius: var(--radius-md);
    background: var(--dead-fill);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .flow { display: flex; flex-direction: column; gap: var(--space-8); }
  .flow > .note, .flow > .error { margin-block-end: 0; }
  .flow :global(.step-h) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-md);
    margin-block-end: var(--space-3);
  }
  .flow :global(.step-n) {
    display: grid;
    place-items: center;
    inline-size: 20px;
    block-size: 20px;
    border-radius: var(--radius-full);
    background: var(--surface-active);
    font-family: var(--font-data);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .problems { display: grid; gap: var(--space-2); }
  @media (min-width: 640px) { .problems { grid-template-columns: 1fr 1fr; } }
  /* The two cards that carry a field are full width in every state, so opening
     one reflows nothing: no sideways jump, no re-pairing of its neighbours.
     They sit last in the list, so the single-tap cards still pair up cleanly. */
  .problems li.wide { grid-column: 1 / -1; }

  .problem {
    display: grid;
    gap: 2px;
    inline-size: 100%;
    min-block-size: 58px;
    padding: var(--space-3);
    text-align: start;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    transition: border-color var(--dur-fast) var(--ease-standard),
      background var(--dur-fast) var(--ease-standard);
  }
  .problem:hover { border-color: var(--signal-dim); background: var(--signal-fill); }
  .problem-label { font-weight: var(--weight-medium); color: var(--text-primary); }
  .problem-hint { font-size: var(--text-sm); color: var(--text-tertiary); }

  .problem-open { display: block; padding: 0; }
  .problem-open summary {
    display: grid;
    gap: 2px;
    padding: var(--space-3);
    cursor: pointer;
    list-style: none;
  }
  .problem-open summary::-webkit-details-marker { display: none; }
  .problem-open[open] { border-color: var(--signal-dim); background: var(--signal-fill); }
  .card-body {
    display: grid;
    gap: var(--space-2);
    padding: 0 var(--space-3) var(--space-3);
  }
  .card-body .textarea { min-block-size: 0; }
  .card-body .field-hint { margin: 0; }
  .row-2 { display: flex; gap: var(--space-2); align-items: center; }
  .row-2 .input { flex: 1; }
  .row-2.end { justify-content: space-between; }

  /* Where supported, the card animates its own height so the change reads as
     growth rather than a jump. Falls back to instant. */
  @supports (interpolate-size: allow-keywords) {
    :root { interpolate-size: allow-keywords; }
    .problem-open::details-content {
      block-size: 0;
      overflow: clip;
      transition: block-size var(--dur-slow) var(--ease-out), content-visibility var(--dur-slow);
      transition-behavior: allow-discrete;
    }
    .problem-open[open]::details-content { block-size: auto; }
  }


  .foot-note {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
