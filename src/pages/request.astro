---
import Base from '../layouts/Base.astro';
import RequestFinder from '../components/RequestFinder.svelte';
import FeatureAsk from '../components/FeatureAsk.svelte';
import { and, eq, inArray } from 'drizzle-orm';
import { db } from '../lib/db/client';
import { OPEN_STATUSES, reports } from '../lib/db/schema';
import { canWriteNow, currentUser } from '../lib/auth';
import { ensureVote } from '../lib/vote';
import { getSource, languageFacets, PICKER_LANGS, PICKER_ROWS } from '../lib/sources';
import { normaliseUrl } from '../lib/problems';
import { duplicateOf } from '../lib/requests';
import { FILING_COOLDOWN_MESSAGE, isReportId, overFilingLimit } from '../lib/writes';
import { announceFiled } from '../lib/webhook';

export const prerender = false;

const user = await currentUser(Astro);
const langs = languageFacets();

type Draft = { name: string; url: string; lang: string; nsfw: boolean };
/** The change path's draft, kept under its own key so the two never collide. */
type ChangeDraft = { sourceId: string; title: string; detail: string };

let error: string | null = null;
let resumed = false;

let name = '';
let url = '';
let lang = '';
let nsfw = false;

/* The change path's fields. */
let sourceId = '';
let askTitle = '';
let detail = '';

let postedMode = '';

/** Which path is on screen. The form posts back to the same URL, so this
    survives a submit; the hidden field below is the belt to that braces. */
const wantsChange = () =>
  Astro.url.searchParams.get('for') === 'change' ||
  (Astro.request.method === 'POST' && postedMode === 'change');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  postedMode = String(form.get('mode') ?? '').trim().slice(0, 8);
  sourceId = String(form.get('source') ?? '').trim().slice(0, 32);
  // Raw title kept uncapped for validation so a 200-char pasted value is
  // refused rather than silently stored as its first 120 characters.
  const rawTitle = String(form.get('title') ?? '').trim();
  askTitle = rawTitle.slice(0, 120);
  detail = String(form.get('detail') ?? '').trim().slice(0, 2000);
  name = String(form.get('name') ?? '').trim().slice(0, 80);
  url = String(form.get('url') ?? '').trim().slice(0, 200);
  // Capped like the other two, and capped *here* rather than at validation:
  // the anonymous branch below writes this straight into the session, so an
  // uncapped value was a half-megabyte KV write before anything had looked at
  // it. The whitelist further down is what makes it a language.
  lang = String(form.get('lang') ?? '').trim().slice(0, 16);
  nsfw = form.get('nsfw') === '1';

  /* --- joining an existing request --------------------------------------
     The form's type-ahead offers the open requests that look like the one being
     typed, and its Add my vote button submits this field. It is handled before
     any validation because none of it applies: joining needs no language, no
     address and no name — only a request that is still open.

     The id is not trusted. It is re-read here as an open row of one of the two
     kinds this page files, which is both an authorisation check (nothing else
     on the board can be joined through this form) and what makes the anonymous
     branch below safe to remember. */
  const joinId = Number(form.get('join') ?? 0);
  if (isReportId(joinId)) {
    const [target] = await db()
      .select({ id: reports.id })
      .from(reports)
      .where(
        and(
          eq(reports.id, joinId),
          inArray(reports.kind, ['request', 'feature']),
          inArray(reports.status, [...OPEN_STATUSES]),
        ),
      );

    if (target) {
      const to = `/report/${target.id}?joined=1`;
      if (!user) {
        /* The same session key /vote uses, replayed by /auth/callback — so the
           click survives the sign-in detour instead of being discarded. Set
           only for an id the query above has just proved votable, which is the
           rule that keeps a poisoned session out of every later sign-in. */
        Astro.session?.set('pending_vote', target.id);
        return Astro.redirect(`/auth/discord?next=${encodeURIComponent(to)}`, 302);
      }
      if (!(await canWriteNow(user))) return Astro.redirect('/cant-post', 302);
      // Outside the filing cooldown, like the dedupe path below: being asked to
      // wait before agreeing with someone is the one thing this board least
      // wants to say.
      await ensureVote(target.id, user.id);
      return Astro.redirect(to, 303);
    }
    /* The suggestion went stale — fixed or closed while the form sat open. Fall
       through and treat it as an ordinary filing rather than explaining that. */
  }

  if (wantsChange()) {
    /* --- a change to a source that already exists ------------------------ */
    if (!user) {
      // Preserve the raw title so an over-length paste still fails validation
      // after the OAuth round trip, rather than being silently truncated to 120.
      Astro.session?.set(
        'pending_change',
        { sourceId, title: rawTitle.slice(0, 500), detail } satisfies ChangeDraft,
      );
      return Astro.redirect('/auth/discord?next=/request%3Ffor%3Dchange', 302);
    }
    if (!(await canWriteNow(user))) return Astro.redirect('/cant-post', 302);

    // The catalogue is the authority for the source, exactly as on /new: an id
    // that is not in it is not a source, whatever the form said.
    const source = getSource(sourceId);

    if (!source) {
      error = 'Pick which source this is about first.';
    } else if (askTitle.length < 6) {
      error = "Say what you want in a sentence. \"Add login\" is enough; a word is not.";
    } else if (rawTitle.length > 120) {
      error = 'Keep it to one sentence — 120 characters at most.';
    } else {
      const [existing] = await db()
        .select({ id: reports.id })
        .from(reports)
        .where(
          and(
            eq(reports.kind, 'feature'),
            eq(reports.sourceId, source.id),
            eq(reports.title, askTitle),
            inArray(reports.status, [...OPEN_STATUSES]),
          ),
        )
        .limit(1);
      if (existing) {
        await ensureVote(existing.id, user.id);
        return Astro.redirect(`/report/${existing.id}?joined=1`, 303);
      }
      if (await overFilingLimit(user.id)) {
        error = FILING_COOLDOWN_MESSAGE;
      } else {
        const [created] = await db()
          .insert(reports)
          .values({
            kind: 'feature',
            sourceId: source.id,
            // Both denormalised from the catalogue, as /new does it: the board
            // filters on them, and the catalogue is what answers for a source
            // that exists. A person is never asked either question here.
            lang: source.lang,
            nsfw: source.nsfw,
            title: askTitle,
            body: detail || null,
            reporterId: user.id,
            /* `problem` is deliberately left null.

               It is the third column of reports_open_per_source_problem, and
               problemKeyFor hands a source-bearing non-bug kind 'other' — so
               writing it would allow exactly one open feature request per source
               and turn the second person's "add login" into a duplicate of the
               first person's "import my library". SQLite lets nulls repeat in a
               unique index, which is what keeps two different asks about one
               source two rows. The panel on the form is what prevents the real
               duplicates; see FeatureAsk.svelte. */
          })
          .onConflictDoNothing()
          .returning({
            id: reports.id,
            kind: reports.kind,
            title: reports.title,
            stage: reports.stage,
            cause: reports.cause,
            sourceId: reports.sourceId,
            proposedName: reports.proposedName,
            proposedUrl: reports.proposedUrl,
            reporterId: reports.reporterId,
          });

        if (!created) {
          const [existingAfter] = await db()
            .select({ id: reports.id })
            .from(reports)
            .where(
              and(
                eq(reports.kind, 'feature'),
                eq(reports.sourceId, source.id),
                eq(reports.title, askTitle),
                inArray(reports.status, [...OPEN_STATUSES]),
              ),
            )
            .limit(1);
          if (existingAfter) {
            await ensureVote(existingAfter.id, user.id);
            return Astro.redirect(`/report/${existingAfter.id}?joined=1`, 303);
          }
          error = 'Could not create request. Try again.';
        } else {
          await ensureVote(created.id, user.id);
          const after: Promise<unknown>[] = [announceFiled(created, Astro.url.origin)];
          const cf = Astro.locals.cfContext;
          if (cf) for (const task of after) cf.waitUntil(task);
          else await Promise.all(after);
          return Astro.redirect(`/report/${created.id}?filed=1`, 303);
        }
      }
    }
  } else {
    /* --- a source that is not in the catalogue yet ---------------------- */
    if (!user) {
      Astro.session?.set('pending_request', { name, url, lang, nsfw } satisfies Draft);
      return Astro.redirect('/auth/discord?next=/request', 302);
    }
    // Re-derived on every write instead of trusted from the session: see
    // canWriteNow in lib/auth.
    if (!(await canWriteNow(user))) return Astro.redirect('/cant-post', 302);

    const link = normaliseUrl(url);

    if (name.length < 2) {
      error = "What's the site called?";
    } else if (!link) {
      error = url.trim()
        ? "That doesn't look like a web address. Paste the full link, e.g. https://example.com"
        : 'Add the address. A request without a link cannot be built from.';
    } else if (!lang) {
      error = 'Pick the language the site is in.';
    } else if (!langs.some((l) => l.code === lang)) {
      // The select only offers the catalogue's languages, so anything else was
      // not typed by a person using this form. It was stored unchecked and then
      // rendered on /requests as if it were a language.
      error = 'Pick the language from the list.';
    } else {
      const d = db();
      // Small table (~130 open requests), so match in memory: same link *or* the
      // same name, because the point is that filing again upvotes rather than
      // duplicating, and people reach the same site by different URLs.
      const open = await d
        .select({ id: reports.id, name: reports.proposedName, url: reports.proposedUrl })
        .from(reports)
        .where(and(eq(reports.kind, 'request'), inArray(reports.status, [...OPEN_STATUSES])));

      /* One rule, two surfaces: duplicateOf in lib/requests is what the form's
         type-ahead warns with as well, so the panel cannot promise a merge the
         server then declines to make. Hosts compared for equality, never
         containment — see hostOf for what the substring test let through. */
      const existing = duplicateOf(open, name, link);

      if (existing) {
        // Joining an existing request is a vote, so it is deliberately outside
        // the cooldown below: being asked to wait before agreeing with someone
        // would be the one thing this board most wants people to do.
        await ensureVote(existing.id, user.id);
        return Astro.redirect(`/report/${existing.id}?joined=1`, 303);
      }

      if (await overFilingLimit(user.id)) {
        error = FILING_COOLDOWN_MESSAGE;
      } else {
        const [created] = await d
          .insert(reports)
          .values({
            kind: 'request',
            proposedName: name,
            proposedUrl: link,
            lang,
            nsfw,
            title: `Add ${name}`,
            reporterId: user.id,
            // No `votes: 1` seed. The counter and the vote row are one fact, and
            // seeding it here meant ensureVote below found no row of its own,
            // inserted one and incremented again — so every request was born
            // claiming two people wanted it and only one had said so.
          })
          .returning({
            id: reports.id,
            kind: reports.kind,
            title: reports.title,
            stage: reports.stage,
            cause: reports.cause,
            sourceId: reports.sourceId,
            proposedName: reports.proposedName,
            // For the announcement's Address field — see announceFiled.
            proposedUrl: reports.proposedUrl,
            reporterId: reports.reporterId,
          });

        if (created) {
          await ensureVote(created.id, user.id);
          const after: Promise<unknown>[] = [announceFiled(created, Astro.url.origin)];
          const cf = Astro.locals.cfContext;
          if (cf) for (const task of after) cf.waitUntil(task);
          else await Promise.all(after);
          return Astro.redirect(`/report/${created.id}?filed=1`, 303);
        }
      }
    }
  }
}

if (Astro.request.method === 'GET') {
  if (wantsChange()) {
    const draft = (await Astro.session?.get('pending_change')) as ChangeDraft | undefined;
    if (draft) {
      Astro.session?.delete('pending_change');
      resumed = true;
      ({ sourceId, title: askTitle, detail } = draft);
    }
  } else {
    const draft = (await Astro.session?.get('pending_request')) as Draft | undefined;
    if (draft) {
      Astro.session?.delete('pending_request');
      resumed = true;
      ({ name, url, lang, nsfw } = draft);
    } else {
      name = Astro.url.searchParams.get('name')?.trim().slice(0, 80) ?? '';
    }
  }
}

const change = wantsChange();

const pickerRows = PICKER_ROWS;
const pickerLangs = PICKER_LANGS;
const picked = sourceId ? getSource(sourceId) : undefined;
---

<Base title="Make a request" narrow>
  <h1>Make a request</h1>
  <p class="lede">
    {
      change
        ? "Something the extension should do that it doesn't. Pick the source, say what you want."
        : "A site that isn't in the list yet. Name, address, language."
    }
  </p>

  {/* Two links, not a control: each path is a page somebody can send, and the
      chooser works with JavaScript off. aria-current says which one you are on
      without relying on the colour to carry it. */}
  <nav class="modes" aria-label="What are you asking for?">
    <a class="chip" href="/request" aria-current={change ? undefined : 'page'}>
      A source that isn't listed
    </a>
    <a class="chip" href="/request?for=change" aria-current={change ? 'page' : undefined}>
      A change to one that is
    </a>
  </nav>

  {
    !user && (
      <p class="note">
        You'll be asked to sign in with Discord when you send. What you typed is kept.
      </p>
    )
  }

  <form method="POST" class="flow">
    {/* The mode the server acts on. The form posts back to this same URL, so the
        query string would answer too, but only this survives a changed action. */}
    <input type="hidden" name="mode" value={change ? 'change' : 'source'} />

    {
      resumed && !error && (
        <p class="note" role="status">Welcome back. Your request is still here. Send it.</p>
      )
    }
    {error && <p class="error" role="alert">{error}</p>}

    {
      change ? (
        <>
          {/* The source, and every open ask already filed against it once one is
              picked. client:load because the panel is the only thing standing
              between two people and a duplicate — the index cannot do it here,
              see the insert above. */}
          <FeatureAsk
            sources={pickerRows}
            langLabels={pickerLangs}
            selectedId={sourceId}
            selectedName={picked?.name ?? ''}
            client:load
          />

          <div class="field">
            <label class="label" for="title">What should it do?</label>
            <input
              class="input"
              id="title"
              name="title"
              value={askTitle}
              placeholder="e.g. Import my library from AniList"
              autocomplete="off"
              minlength="6"
              maxlength="120"
              required
            />
            <p class="field-hint">
              One sentence. This is the line the board shows, so it is worth
              being specific.
            </p>
          </div>

          <div class="field">
            <label class="label" for="detail">Anything else worth knowing?</label>
            <textarea class="textarea" id="detail" name="detail" rows="3" maxlength="2000"
              placeholder="Optional. Where it should appear, what you'd expect to happen, anything you've tried."
              >{detail}</textarea>
          </div>

          <div>
            {/* Said in words, and revealed by the island — a dimmed button with
                no reason beside it leaves the reason to be guessed, which is the
                same call /new makes with its problem cards. Hidden until the
                island confirms no source is picked, so with JavaScript off the
                button stays live and the server does the refusing. */}
            <p class="needs-source" role="status">Pick the source first.</p>
            {/* data-gate: FeatureAsk disables this until a source is picked, so
                an anonymous visitor cannot spend a Discord round trip on a
                submission the server was always going to refuse. */}
            <button class="btn btn-primary btn-lg" type="submit" data-gate="source">
              Send request
            </button>
          </div>
        </>
      ) : (
        <>
          {/* Name and address, and — once they say something recognisable — the
              open requests that look like the same site, each with a button that
              joins it. client:load because the whole value is in answering
              before the form is sent; with JavaScript off these are two plain
              fields and the server still merges a duplicate on submit. */}
          <RequestFinder name={name} url={url} client:load />

          <div class="field">
            <label class="label" for="lang">Language</label>
            <select class="select" id="lang" name="lang" required>
              <option value="" disabled selected={!lang}>Pick one…</option>
              {
                langs.map((l) => (
                  <option value={l.code} selected={l.code === lang}>
                    {l.label}
                  </option>
                ))
              }
            </select>
            <p class="field-hint">
              The language the site is in. It's the main filter on the requests board.
            </p>
          </div>

          <label class="check">
            <input type="checkbox" name="nsfw" value="1" checked={nsfw} />
            <span>It's an 18+ site</span>
          </label>

          <div>
            <button class="btn btn-primary btn-lg" type="submit">Send request</button>
          </div>
        </>
      )
    }
  </form>

  <p class="foot-note">
    Requests are ranked by how many people ask for the same thing, so voting on
    an existing one counts for as much as filing a new one.
  </p>
</Base>

<style>
  h1 { font-size: var(--text-xl); }
  .lede {
    max-inline-size: 56ch;
    color: var(--text-tertiary);
    margin-block: var(--space-1) var(--space-4);
  }
  /* The segmented shape the filter bar uses, built out of links. */
  .modes {
    display: flex;
    gap: 2px;
    padding: 2px;
    margin-block-end: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .modes .chip { border-color: transparent; }
  .modes .chip[aria-current='page'] {
    background: var(--signal-fill);
    border-color: var(--signal-dim);
    color: var(--signal-ink);
    font-weight: var(--weight-medium);
  }
  .flow { display: flex; flex-direction: column; gap: var(--space-5); }
  @media (max-width: 560px) {
    .lede { margin-block-end: var(--space-3); }
    .modes { margin-block-end: var(--space-4); }
    .flow { gap: var(--space-4); }
    /* Two lines of label at 390px, so let each take the height it needs rather
       than truncating the words that say what the choice is. */
    .modes .chip { flex: 1; text-align: center; block-size: auto; padding-block: var(--space-2); }
  }
  .note {
    margin-block-end: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-default);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .flow .note { margin-block-end: 0; }
  /* Same mechanism as the problem cards on /new: the island reveals it. */
  .needs-source {
    display: none;
    margin-block-end: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .flow[data-needs-source] .needs-source { display: block; }
  .flow .field + .field { margin-block-start: 0; }
  .error {
    padding: var(--space-3);
    border: 1px solid var(--dead);
    border-inline-start-width: 2px;
    border-radius: var(--radius-md);
    background: var(--dead-fill);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  .check {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    cursor: pointer;
  }
  .check input {
    inline-size: 18px;
    block-size: 18px;
    accent-color: var(--signal);
  }
  .foot-note {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
