---
import Base from '../layouts/Base.astro';
import RequestFinder from '../components/RequestFinder.svelte';
import { and, eq, inArray } from 'drizzle-orm';
import { db } from '../lib/db/client';
import { OPEN_STATUSES, reports } from '../lib/db/schema';
import { canWriteNow, currentUser } from '../lib/auth';
import { ensureVote } from '../lib/vote';
import { languageFacets } from '../lib/sources';
import { normaliseUrl } from '../lib/problems';
import { duplicateOf } from '../lib/requests';
import { FILING_COOLDOWN_MESSAGE, isReportId, overFilingLimit } from '../lib/writes';
import { announceFiled } from '../lib/webhook';

export const prerender = false;

/**
 * Asking for a source that does not exist yet.
 *
 * Separate from /new because none of that page applies: there is no extension
 * to be out of date, no failure stage, and nothing to pick from the catalogue.
 * Requests are 58% of the open backlog, so this is a first-class flow rather
 * than a mode of the report form.
 */

const user = await currentUser(Astro);
const langs = languageFacets();

type Draft = { name: string; url: string; lang: string; nsfw: boolean };

let error: string | null = null;
let resumed = false;

let name = '';
let url = '';
let lang = '';
let nsfw = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  name = String(form.get('name') ?? '').trim().slice(0, 80);
  url = String(form.get('url') ?? '').trim().slice(0, 200);
  // Capped like the other two, and capped *here* rather than at validation:
  // the anonymous branch below writes this straight into the session, so an
  // uncapped value was a half-megabyte KV write before anything had looked at
  // it. The whitelist further down is what makes it a language.
  lang = String(form.get('lang') ?? '').trim().slice(0, 16);
  nsfw = form.get('nsfw') === '1';

  /* --- joining an existing request --------------------------------------
     The form's type-ahead offers the open requests that look like the one being
     typed, and its Add my vote button submits this field. It is handled before
     any validation because none of it applies: joining needs no language, no
     address and no name — only a request that is still open.

     The id is not trusted. It is re-read here as an open request of kind
     `request`, which is both an authorisation check (nothing else on the board
     can be joined through this form) and what makes the anonymous branch below
     safe to remember. */
  const joinId = Number(form.get('join') ?? 0);
  if (isReportId(joinId)) {
    const [target] = await db()
      .select({ id: reports.id })
      .from(reports)
      .where(
        and(
          eq(reports.id, joinId),
          eq(reports.kind, 'request'),
          inArray(reports.status, [...OPEN_STATUSES]),
        ),
      );

    if (target) {
      const to = `/report/${target.id}?joined=1`;
      if (!user) {
        /* The same session key /vote uses, replayed by /auth/callback — so the
           click survives the sign-in detour instead of being discarded. Set
           only for an id the query above has just proved votable, which is the
           rule that keeps a poisoned session out of every later sign-in. */
        Astro.session?.set('pending_vote', target.id);
        return Astro.redirect(`/auth/discord?next=${encodeURIComponent(to)}`, 302);
      }
      if (!(await canWriteNow(user))) return Astro.redirect('/cant-post', 302);
      // Outside the filing cooldown, like the dedupe path below: being asked to
      // wait before agreeing with someone is the one thing this board least
      // wants to say.
      await ensureVote(target.id, user.id);
      return Astro.redirect(to, 303);
    }
    /* The suggestion went stale — fixed or closed while the form sat open. Fall
       through and treat it as an ordinary filing rather than explaining that. */
  }

  if (!user) {
    Astro.session?.set('pending_request', { name, url, lang, nsfw } satisfies Draft);
    return Astro.redirect('/auth/discord?next=/request', 302);
  }
  // Re-derived on every write instead of trusted from the session: see
  // canWriteNow in lib/auth.
  if (!(await canWriteNow(user))) return Astro.redirect('/cant-post', 302);

  const link = normaliseUrl(url);

  if (name.length < 2) {
    error = "What's the site called?";
  } else if (!link) {
    error = url.trim()
      ? "That doesn't look like a web address. Paste the full link, e.g. https://example.com"
      : 'Add the address. A request without a link cannot be built from.';
  } else if (!lang) {
    error = 'Pick the language the site is in.';
  } else if (!langs.some((l) => l.code === lang)) {
    // The select only offers the catalogue's languages, so anything else was
    // not typed by a person using this form. It was stored unchecked and then
    // rendered on /requests as if it were a language.
    error = 'Pick the language from the list.';
  } else {
    const d = db();
    // Small table (~130 open requests), so match in memory: same link *or* the
    // same name, because the point is that filing again upvotes rather than
    // duplicating, and people reach the same site by different URLs.
    const open = await d
      .select({ id: reports.id, name: reports.proposedName, url: reports.proposedUrl })
      .from(reports)
      .where(and(eq(reports.kind, 'request'), inArray(reports.status, [...OPEN_STATUSES])));

    /* One rule, two surfaces: duplicateOf in lib/requests is what the form's
       type-ahead warns with as well, so the panel cannot promise a merge the
       server then declines to make. Hosts compared for equality, never
       containment — see hostOf for what the substring test let through. */
    const existing = duplicateOf(open, name, link);

    if (existing) {
      // Joining an existing request is a vote, so it is deliberately outside
      // the cooldown below: being asked to wait before agreeing with someone
      // would be the one thing this board most wants people to do.
      await ensureVote(existing.id, user.id);
      return Astro.redirect(`/report/${existing.id}?joined=1`, 303);
    }

    if (await overFilingLimit(user.id)) {
      error = FILING_COOLDOWN_MESSAGE;
    } else {
      const [created] = await d
        .insert(reports)
        .values({
          kind: 'request',
          proposedName: name,
          proposedUrl: link,
          lang,
          nsfw,
          title: `Add ${name}`,
          reporterId: user.id,
          // No `votes: 1` seed. The counter and the vote row are one fact, and
          // seeding it here meant ensureVote below found no row of its own,
          // inserted one and incremented again — so every request was born
          // claiming two people wanted it and only one had said so.
        })
        .returning({
          id: reports.id,
          kind: reports.kind,
          title: reports.title,
          stage: reports.stage,
          cause: reports.cause,
          sourceId: reports.sourceId,
          proposedName: reports.proposedName,
          // For the announcement's Address field — see announceFiled.
          proposedUrl: reports.proposedUrl,
          reporterId: reports.reporterId,
        });

      if (created) {
        await ensureVote(created.id, user.id);
        const after: Promise<unknown>[] = [announceFiled(created, Astro.url.origin)];
        const cf = Astro.locals.cfContext;
        if (cf) for (const task of after) cf.waitUntil(task);
        else await Promise.all(after);
        return Astro.redirect(`/report/${created.id}?filed=1`, 303);
      }
    }
  }
}

if (Astro.request.method === 'GET') {
  const draft = (await Astro.session?.get('pending_request')) as Draft | undefined;
  if (draft) {
    Astro.session?.delete('pending_request');
    resumed = true;
    ({ name, url, lang, nsfw } = draft);
  } else {
    name = Astro.url.searchParams.get('name')?.trim().slice(0, 80) ?? '';
  }
}
---

<Base title="Request a source" narrow>
  <h1>Request a source</h1>
  <p class="lede">
    Name, address, language. If someone already asked for this site you'll be
    added to their request instead of making a second one.
  </p>

  {
    !user && (
      <p class="note">
        You'll be asked to sign in with Discord when you send. What you typed is kept.
      </p>
    )
  }

  <form method="POST" class="flow">
    {
      resumed && !error && (
        <p class="note" role="status">Welcome back. Your request is still here. Send it.</p>
      )
    }
    {error && <p class="error" role="alert">{error}</p>}

    {/* Name and address, and — once they say something recognisable — the open
        requests that look like the same site, each with a button that joins it.
        client:load because the whole value is in answering before the form is
        sent; with JavaScript off these are two plain fields and the server
        still merges a duplicate on submit. */}
    <RequestFinder name={name} url={url} client:load />

    <div class="field">
      <label class="label" for="lang">Language</label>
      <select class="select" id="lang" name="lang" required>
        <option value="" disabled selected={!lang}>Pick one…</option>
        {
          langs.map((l) => (
            <option value={l.code} selected={l.code === lang}>
              {l.label}
            </option>
          ))
        }
      </select>
      <p class="field-hint">
        The language the site is in. It's the main filter on the requests board.
      </p>
    </div>

    <label class="check">
      <input type="checkbox" name="nsfw" value="1" checked={nsfw} />
      <span>It's an 18+ site</span>
    </label>

    <div>
      <button class="btn btn-primary btn-lg" type="submit">Send request</button>
    </div>
  </form>

  <p class="foot-note">
    Requests are ranked by how many people ask for the same site, so voting on an
    existing one counts for as much as filing a new one.
  </p>
</Base>

<style>
  h1 { font-size: var(--text-xl); }
  .lede {
    max-inline-size: 56ch;
    color: var(--text-tertiary);
    margin-block: var(--space-1) var(--space-6);
  }
  .note {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-default);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .flow { display: flex; flex-direction: column; gap: var(--space-5); }
  .flow .field + .field { margin-block-start: 0; }
  .error {
    padding: var(--space-3);
    border: 1px solid var(--dead);
    border-inline-start-width: 2px;
    border-radius: var(--radius-md);
    background: var(--dead-fill);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  .check {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    cursor: pointer;
  }
  .check input {
    inline-size: 18px;
    block-size: 18px;
    accent-color: var(--signal);
  }
  .foot-note {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
