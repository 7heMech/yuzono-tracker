---
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import ReportRow from '../components/ReportRow.astro';
import SourceFinder from '../components/SourceFinder.svelte';
import { board, boardCounts, type Sort } from '../lib/queries';
import { SOURCES, langLabel } from '../lib/sources';

// Reads D1, so this route is on-demand. The per-source pages are the ones that
// prerender; this board is cached at the edge instead.
export const prerender = false;

const q = Astro.url.searchParams;
const lang = q.get('lang') ?? '';
const cause = q.get('cause') ?? '';
const nsfw = q.get('nsfw') === '1';
const sort = (q.get('sort') ?? 'demand') as Sort;

const [{ rows }, counts] = await Promise.all([
  board({ family: 'broken', lang, cause, nsfw, sort }),
  boardCounts(),
]);

// Anonymous browsing is the overwhelming majority of traffic and touches no
// user state, so it can sit in the edge cache for a minute.
const finderRows = SOURCES.map((s) => ({ id: s.id, name: s.name, lang: s.lang, nsfw: s.nsfw, extName: s.extName }));
const langLabels = Object.fromEntries([...new Set(SOURCES.map((s) => s.lang))].map((c) => [c, langLabel(c)]));

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
---

<Base title="Broken sources">
  <header class="head">
    <div class="head-text">
      <h1>Broken sources</h1>
      <p class="sub">
        Ranked by how many people are hit. Reporting something already listed
        just adds you to it.
      </p>
    </div>
    <dl class="tallies">
      <div><dt class="label">Open</dt><dd class="num">{counts.broken}</dd></div>
      <div><dt class="label">Wanted</dt><dd class="num">{counts.wanted}</dd></div>
      <div>
        <dt class="label">Stalled 90d+</dt>
        <dd class="num rotting">{counts.stalled}</dd>
      </div>
    </dl>
  </header>

  <section class="finder-block">
    <SourceFinder sources={finderRows} langLabels={langLabels} client:load />
    <p class="finder-hint">
      Or <a href="/new">report a problem</a> — takes two taps.
    </p>
  </section>

  <FilterBar family="broken" lang={lang} cause={cause} nsfw={nsfw} sort={sort} />

  {
    rows.length === 0 ? (
      <div class="empty">
        <p class="empty-title">Nothing broken here</p>
        <p>
          {lang || cause
            ? 'No open reports match these filters. Try widening them.'
            : 'No open reports yet. If a source is broken for you, be the first to say so.'}
        </p>
        <a class="btn btn-primary" href="/new">Report a broken source</a>
      </div>
    ) : (
      <ol class="rows">
        {rows.map((r) => (
          <ReportRow report={r} />
        ))}
      </ol>
    )
  }

</Base>

<style>
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border-subtle);
  }
  h1 {
    font-size: var(--text-xl);
    letter-spacing: var(--track-tight);
  }
  .sub {
    max-inline-size: 52ch;
    margin-block-start: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .tallies {
    display: flex;
    gap: var(--space-6);
  }
  .tallies dd {
    font-family: var(--font-data);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semi);
    line-height: var(--leading-none);
    letter-spacing: var(--track-tighter);
    margin-block-start: var(--space-1);
  }
  .rotting {
    color: var(--stalled);
  }

  .finder-block {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-block: var(--space-5) var(--space-1);
  }
  .finder-block :global(.finder) { flex: 1; min-inline-size: 18rem; max-inline-size: 30rem; }
  .finder-hint {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    padding-block-end: var(--space-2);
  }
  .finder-hint a {
    color: var(--signal-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

</style>
