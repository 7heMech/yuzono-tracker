---
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import RequestSearch from '../components/RequestSearch.svelte';
import ReportRow from '../components/ReportRow.astro';
import { currentUser } from '../lib/auth';
import {
  board,
  boardCounts,
  edgeCachedRender,
  FRESH_PARAM,
  myVotes,
  PAGE_SIZE,
  type BoardState,
  type Sort,
} from '../lib/queries';

export const prerender = false;

const q = Astro.url.searchParams;
const lang = q.get('lang') ?? '';
const nsfw = q.get('nsfw') === '1';
const state: BoardState = q.get('state') === 'fixed' ? 'fixed' : 'open';
/* Each view has its own default order, and board() falls the other one's back:
   the fixed board leads with what was fixed most recently, the open board with
   what most people want. */
const sort = (q.get('sort') ?? (state === 'fixed' ? 'fixed' : 'demand')) as Sort;

/* 1-based first row of this page, so ?from=61 matches the "Showing 61–120" the
   pager prints. */
const from = Math.max(1, Number.parseInt(q.get('from') ?? '', 10) || 1);

const user = await currentUser(Astro);

/* --- edge cache: anonymous renders only -----------------------------------
   Every row carries `mine`, so a signed-in render is that person's vote state
   and must never be stored where the next visitor can be handed it. Signed in
   means rendered fresh, every time. */
const cacheable = !user;
if (cacheable && !q.has(FRESH_PARAM)) {
  const cached = await edgeCachedRender(Astro);
  if (cached) return cached;
}

const [{ rows, total, offset }, counts] = await Promise.all([
  board({ family: 'wanted', state, lang, nsfw, sort, offset: from - 1 }),
  boardCounts(nsfw),
]);

/** A pager link that keeps every active filter and drops the cache marker. */
function pageHref(startRow: number) {
  const u = new URL(Astro.url);
  u.searchParams.delete(FRESH_PARAM);
  if (startRow <= 1) u.searchParams.delete('from');
  else u.searchParams.set('from', String(startRow));
  return u.pathname + u.search;
}

/* A `from` past the end of the list is a stale bookmark or a typed number, so
   the first page is what was meant. Redirecting keeps the pager's arithmetic
   honest: it never has to describe a page that holds nothing. */
if (rows.length === 0 && offset > 0) return Astro.redirect(pageHref(1), 302);

// Without this every row rendered aria-pressed="false", and because /vote
// toggles, tapping a request you had already backed removed your vote.
const mine = user ? await myVotes(user.id, rows.map((r) => r.id)) : new Set<number>();

const shownFrom = offset + 1;
const shownTo = offset + rows.length;
const nextCount = Math.min(PAGE_SIZE, total - shownTo);

Astro.response.headers.set(
  'Cache-Control',
  cacheable
    ? 'public, max-age=0, s-maxage=60, stale-while-revalidate=300'
    : // Per-viewer vote state. Saying so is cheaper than trusting that no
      // shared cache sits in front of this.
      'private, no-store',
);
---

<Base title="Requested sources">
  <header class="head">
    <div>
      <h1>{state === 'fixed' ? 'Requests that got built' : 'Requests'}</h1>
      <p class="sub">
        {state === 'fixed' ? (
          <>
            Requests that have been built, most recently finished first. There
            are {counts.wantedFixed} of them, against {counts.wanted} still open.
          </>
        ) : (
          <>
            Sources people want added, and changes they want to sources that
            already exist, ranked by demand. This is the larger half of the
            backlog, {counts.wanted} open against {counts.broken} broken sources,
            so votes here decide what gets built next.
          </>
        )}
      </p>
    </div>
  </header>

  {/* The same block the broken board opens with, over this board's own
      contents: the first question anyone arrives with is whether the thing they
      want is already here, and the answer to "no" is the link beside it. This
      was a full-width primary button, which had to shout because it was the
      only way on to /request at all. */}
  {
    state === 'open' && (
      <section class="finder-block">
        <RequestSearch client:load />
        <p class="finder-hint">
          Don't find the extension or the feature you want?{' '}
          <a href="/request">Make a request</a>.
        </p>
      </section>
    )
  }

  <FilterBar
    family="wanted"
    state={state}
    openCount={counts.wanted}
    fixedCount={counts.wantedFixed}
    lang={lang}
    nsfw={nsfw}
    sort={sort}
  />

  {
    rows.length === 0 ? (
      <div class="empty">
        <p class="empty-title">
          {state === 'fixed' ? 'Nothing added yet' : 'No open requests'}
        </p>
        {state === 'fixed' ? (
          <a class="btn" href="/requests">See what people are asking for</a>
        ) : (
          <a class="btn btn-primary" href="/request">Make a request</a>
        )}
      </div>
    ) : (
      <ol class="rows">
        {rows.map((r) => (
          <ReportRow report={r} mine={mine.has(r.id)} />
        ))}
      </ol>
    )
  }

  {/* Plain words and plain numbers, and two ordinary links — this works with
      JavaScript off, and a filter change resets to row 1 on purpose, because
      FilterBar's GET form does not carry `from`. */}
  {
    (shownTo < total || offset > 0) && (
      <nav class="pager" aria-label="More requests">
        <p class="pager-count">
          Showing {shownFrom}–{shownTo} of {total}{' '}
          {state === 'fixed' ? 'added sources' : 'open requests'}
        </p>
        <div class="pager-links">
          {offset > 0 && (
            <a class="btn" rel="prev" href={pageHref(Math.max(1, offset + 1 - PAGE_SIZE))}>
              Previous {Math.min(PAGE_SIZE, offset)}
            </a>
          )}
          {nextCount > 0 && (
            <a class="btn" rel="next" href={pageHref(shownTo + 1)}>
              Next {nextCount}
            </a>
          )}
        </div>
      </nav>
    )
  }
</Base>

<style>
  .head {
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border-subtle);
  }
  h1 { font-size: var(--text-xl); letter-spacing: var(--track-tight); }
  .sub {
    max-inline-size: 62ch;
    margin-block-start: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  /* Verbatim from the broken board, so the two are one design and not two that
     resemble each other. */
  .finder-block {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-block: var(--space-5) var(--space-1);
  }
  .finder-block :global(.finder) { flex: 1; min-inline-size: 18rem; max-inline-size: 30rem; }
  .finder-hint {
    flex: 1;
    min-inline-size: 18rem;
    max-inline-size: 46ch;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    padding-block-end: var(--space-2);
  }
  .finder-hint a {
    color: var(--signal-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* --- pager --- */
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-block-start: var(--space-5);
  }
  .pager-count {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .pager-links {
    display: flex;
    gap: var(--space-2);
  }
  @media (max-width: 640px) {
    /* The count on its own line, then the links side by side across the full
       width: at 390px a right-aligned "Next 60" is a thumb-stretch. */
    .pager { flex-direction: column; align-items: stretch; }
    .pager-links .btn { flex: 1; }
    /* The box takes the width and the line sits under it: at 390px the two
       side by side leave neither enough room to read. */
    .finder-block { flex-direction: column; align-items: stretch; gap: var(--space-2); }
    .finder-hint { min-inline-size: 0; max-inline-size: none; padding-block-end: 0; }
  }
</style>
