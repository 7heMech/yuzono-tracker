---
import UserChip from './UserChip.astro';

// Five destinations do not earn a 260px sidebar. A compact bar keeps the
// board — the thing people came for — at the top of the viewport.
const path = Astro.url.pathname;
const _params = new URLSearchParams(Astro.url.searchParams);
_params.delete('auth');
_params.delete('__fresh');
_params.delete('_cb');
const here = Astro.url.pathname + (_params.toString() ? `?${_params.toString()}` : '');
const signInHref = `/me?next=${encodeURIComponent(here)}`;
const tabs = [
  { href: '/', label: 'Broken', match: (p: string) => p === '/' },
  { href: '/requests', label: 'Requests', match: (p: string) => p.startsWith('/requests') },
  // Trailing slash on purpose: /sources/ is prerendered, so it is emitted as a
  // directory and `/sources` costs every visitor a 307 before the page.
  { href: '/sources/', label: 'Sources', match: (p: string) => p.startsWith('/source') },
];

/**
 * Whether to mount the user island at all.
 *
 * `UserChip` is a server island, and for an anonymous visitor its output is
 * byte-identical to the fallback rendered in its place — so every anonymous
 * view was paying a second Worker invocation to produce markup that was
 * already on the page. `signed_in` is a plain, non-HttpOnly cookie set beside
 * the session cookie purely so this decision can be made without reading the
 * session (which a prerendered page cannot do at all).
 *
 * It is a hint, never an authorisation signal, and nothing here trusts it: the
 * island still reads the real session, so a forged or stale `signed_in=1`
 * buys nothing but a wasted island fetch that renders the signed-out state.
 * The reverse is the interesting case — on the prerendered `/sources/` and
 * `/source/<slug>/` pages there is no request to read at build time, so those
 * pages always ship the guest markup. The link therefore carries both labels
 * ("Sign in" and "Your reports") and points at /me?next=here either way, and
 * CSS picks the label off a `data-signed-in` attribute that
 * src/scripts/session-hint.js sets on <html> before first paint. The corner is
 * correct in the first frame on every page — no post-paint swap, which
 * visitors read as a flicker — and with JavaScript off the guest label simply
 * stays, still routing correctly through /me (which forwards ?next to Discord
 * when there is no session). That is the deliberate trade: 310 pages of
 * cache-friendly HTML for the majority who are not signed in.
 *
 * The island's fallback gets the same treatment: it used to be the Sign in
 * button, which meant a signed-in visitor on a server-rendered page saw
 * "Sign in" for as long as the island fetch took — the same flicker one layer
 * down. The fallback below is the signed-in shape without the identity, so
 * the upgrade adds an avatar instead of replacing a lie.
 */
const maybeSignedIn = Astro.cookies.get('signed_in')?.value === '1';

// The sign-in button appears twice below — once as the island's fallback and
// once as the whole control for a visitor with no cookie. The wordmark path is
// hoisted so only the `<a>` is written twice, not 600 bytes of `d`.
const DISCORD_MARK =
  'M19.3 5.3A16.6 16.6 0 0 0 15.2 4l-.3.6a12.4 12.4 0 0 1 3.7 1.2 12.9 12.9 0 0 0-11-.5l.3-.7A16.5 16.5 0 0 0 4.7 5.3C2.2 9 1.5 12.6 1.9 16.2a16.4 16.4 0 0 0 5 2.5l.6-1a10.7 10.7 0 0 1-1.8-.9l.4-.3a11.7 11.7 0 0 0 10 0l.4.3a10.8 10.8 0 0 1-1.8.9l.6 1a16.3 16.3 0 0 0 5-2.5c.5-4.2-.6-7.8-2.9-10.9ZM8.7 14c-1 0-1.7-.9-1.7-2s.8-2 1.7-2 1.8.9 1.7 2c0 1.1-.8 2-1.7 2Zm6.6 0c-1 0-1.7-.9-1.7-2s.8-2 1.7-2 1.8.9 1.7 2c0 1.1-.8 2-1.7 2Z';
---

<header class="bar">
  <div class="shell inner">
    <a href="/" class="mark">
      <span class="mark-dot" aria-hidden="true"></span>
      <span class="mark-text">yuzono <span>tracker</span></span>
    </a>

    <nav class="tabs" aria-label="Sections">
      {
        tabs.map((t) => (
          <a href={t.href} class="tab" aria-current={t.match(path) ? 'page' : undefined}>
            {t.label}
          </a>
        ))
      }
    </nav>

    <div class="controls">
      {/* Rendered server-side, both icons in the markup, so the button exists
          with JavaScript off and needs no hydration to appear. Which icon
          shows is decided by CSS off `data-theme` — the attribute the head
          script has already set before paint — and the click behaviour is
          delegated from the document in src/scripts/theme.js, which is also
          what keeps the label in step. That pair replaced a Svelte island
          whose runtime was 15.3 KB gzipped on 310 otherwise static pages, for
          one button. */}
      <button id="theme-toggle" class="btn btn-ghost btn-icon theme-btn" type="button" aria-label="Switch theme">
        <svg class="i-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19" />
        </svg>
        <svg class="i-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      {
        maybeSignedIn ? (
          <UserChip server:defer>
            <a class="me-hint" slot="fallback" href="/me" aria-label="Your reports">
              <span class="avatar-blank" aria-hidden="true"></span>
              <span class="me-hint-text">Your reports</span>
            </a>
          </UserChip>
        ) : (
          /* No cookie to read — either the visitor is genuinely signed out, or
             this is one of the 310 prerendered pages, which are built with no
             request at all. The two cases are indistinguishable here, so both
             get this link, and session-hint.js plus the CSS below decide which
             label it wears before the first paint. Signed-out it goes via
             /me to Discord with ?next so the detour returns here; signed-in
             it is the reports page and the ?next is ignored. */
          <a class="btn btn-discord signin-link" href={signInHref}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={DISCORD_MARK} />
            </svg>
            <span class="guest-text">Sign in</span>
            <span class="authed-text">Your reports</span>
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  /* Both labels ship in the one link; which one shows is decided by the root
     attribute session-hint.js sets before first paint. Nothing here is ever
     swapped after paint, so a signed-in visitor never sees "Sign in" flash on
     navigation. The Discord mark is wrong once the link stops going to
     Discord, so it goes with the guest label. */
  .signin-link .authed-text { display: none; }
  :global(:root[data-signed-in]) .signin-link svg,
  :global(:root[data-signed-in]) .signin-link .guest-text { display: none; }
  :global(:root[data-signed-in]) .signin-link .authed-text { display: inline; }
  /* Override .btn-discord in the same layer it is defined in: `src/styles/base.css`
     lives in @layer components, so this has to as well. Unlayered should win
     per the spec, but Chromium's layered-sheet handling in dev keeps the later
     unlayered rule from outranking the earlier layered one, so styling it here
     in `utilities` (which is ordered after components) makes the win explicit
     and keeps the signed-in label de-emphasised — blurple is for theCTA. */
  @layer utilities {
    :global(:root[data-signed-in]) .signin-link {
      background: var(--surface-raised);
      border-color: var(--border-default);
      color: var(--text-secondary);
    }
    :global(:root[data-signed-in]) .signin-link:hover {
      filter: none;
      background: var(--surface-hover);
      border-color: var(--border-strong);
      color: var(--text-primary);
    }
  }

  /* The user island's fallback: the signed-in shape without the identity, so
     the island's arrival adds an avatar rather than replacing a "Sign in"
     button that was never true. Styled to match UserChip's .me so the upgrade
     does not shift anything but the avatar itself. */
  .me-hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .avatar-blank {
    inline-size: 22px;
    block-size: 22px;
    border-radius: var(--radius-full);
    background: var(--surface-active);
  }
  @media (max-width: 700px) {
    .me-hint-text { display: none; }
    .me-hint { padding-inline: var(--space-1); }
  }

  .bar {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    background: color-mix(in oklab, var(--surface-canvas) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-block-end: 1px solid var(--border-subtle);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    min-block-size: 52px;
    padding-block: var(--space-2);
  }
  /* Mobile: the mark and the controls hold the first line, the tabs take a
     full-width second line. Nothing gets pushed off-screen, which is what
     happened when all five items fought for 390px.
     `margin-inline-start: auto` on the controls is what keeps them hard right
     in both layouts — an ordered spacer element got this wrong, because the
     controls default to `order: 0` and so jumped in front of it. */
  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }
  .mark { order: 0; }
  .controls { order: 1; }
  .tabs { order: 2; flex-basis: 100%; }
  @media (min-width: 620px) {
    .inner { flex-wrap: nowrap; padding-block: 0; block-size: 52px; }
    .tabs { order: 1; flex-basis: auto; }
    .controls { order: 2; }
  }

  /* The icon says what the click *does*, not what the theme currently is, so
     the button needs no label to decode: in dark you see a sun to switch to.
     Driven by the root attribute rather than by script, so the right icon is
     there on the first paint. */
  :global(:root[data-theme='dark']) .i-moon,
  :global(:root[data-theme='light']) .i-sun {
    display: none;
  }
  /* No `data-theme` means the head script never ran, which means there is no
     JavaScript here to flip anything. Hide the control rather than show a dead
     button with both icons in it. The attribute is set in <head> before first
     paint, so this never flashes for anyone else. */
  :global(:root:not([data-theme])) .theme-btn {
    display: none;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-semi);
    letter-spacing: var(--track-tight);
    white-space: nowrap;
  }
  /* The one place the accent appears unprompted: a live signal dot. */
  .mark-dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: var(--radius-full);
    background: var(--signal);
    box-shadow: 0 0 0 3px var(--signal-fill);
  }
  .mark-text span {
    color: var(--text-tertiary);
    font-weight: var(--weight-normal);
  }

  .tabs {
    display: flex;
    gap: var(--space-1);
    /* If the labels ever outgrow the line, scroll rather than overflow. */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  @media (min-width: 620px) {
    .tabs { margin-inline-start: var(--space-4); }
  }
  .tab {
    padding: var(--space-2) var(--space-3);
    white-space: nowrap;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-tertiary);
    transition: color var(--dur-fast) var(--ease-standard),
      background var(--dur-fast) var(--ease-standard);
  }
  .tab:hover {
    color: var(--text-secondary);
    background: var(--surface-hover);
  }
  .tab[aria-current='page'] {
    color: var(--text-primary);
    background: var(--surface-active);
  }

  @media (max-width: 560px) {
    .mark-text span { display: none; }
  }
</style>
