---
import { atLeast } from '../lib/levels';
import { avatarUrl, currentUser } from '../lib/auth';
import { safeReturnTo } from '../lib/redirect';

/**
 * The signed-in corner of the header, as a server island.
 *
 * It has to be one: the header appears on 310 prerendered source pages, and a
 * session read there would either fail or force the whole page to render on
 * demand — losing exactly the edge-cached anonymous path the board is built
 * around. As an island the page stays static and only this fragment is live.
 *
 * Header.astro now only mounts this island when the non-secret `signed_in`
 * cookie is present, because for an anonymous visitor the output below is
 * byte-identical to the fallback in the page. That cookie is a hint and not an
 * authorisation signal: the signed-out branch below is what a forged or stale
 * one gets, since the session read here is the only thing that decides.
 */
const user = await currentUser(Astro);
const avatar = user ? avatarUrl(user, 48) : null;
/* Staff get one link, and which one depends on what they can do with it.
   This used to be admins only, on the reasoning that "a moderator's powers live
   on the report they are moderating, not on a settings page" — true until the
   GitHub sync gave moderators a queue of their own at /review. They need a way
   to find it, and it is not a settings page.

   Deliberately one control and not two for admins: the comment below about the
   header having to stay tappable inside 390px is the constraint, and /admin
   links on to /review itself. Also deliberately no pending count here — this
   island renders for every signed-in visitor on every page, so a number here
   would be a database read on all of them to serve something only staff see.

   `user.level` is the level captured at login, which is the right thing for
   deciding what to *show*; both destinations re-authorise on arrival. */
const staff = user ? atLeast(user.level, 'mod') : false;
const staffHref = user && atLeast(user.level, 'admin') ? '/admin' : '/review';
const staffLabel = staffHref === '/admin' ? 'Dashboard' : 'Review';
const here = (() => {
  const ref = Astro.request.headers.get('referer');
  if (ref) {
    const cleaned = safeReturnTo(ref, Astro.url.origin, '');
    if (cleaned && cleaned !== '/' && !cleaned.startsWith('/_server-islands')) {
      const u = new URL(cleaned, Astro.url.origin);
      u.searchParams.delete('auth');
      u.searchParams.delete('__fresh');
      u.searchParams.delete('_cb');
      return u.pathname + (u.search ? u.search : '');
    }
    if (cleaned) {
      const u = new URL(cleaned, Astro.url.origin);
      u.searchParams.delete('auth');
      u.searchParams.delete('__fresh');
      u.searchParams.delete('_cb');
      return u.pathname + (u.search ? u.search : '');
    }
  }
  const fallback = Astro.url.pathname + Astro.url.search;
  if (fallback.startsWith('/_server-islands')) return '/';
  const p = new URLSearchParams(Astro.url.searchParams);
  p.delete('auth');
  p.delete('__fresh');
  p.delete('_cb');
  return Astro.url.pathname + (p.toString() ? `?${p.toString()}` : '');
})();
const signInHref = `/auth/discord?next=${encodeURIComponent(here)}`;
---

{
  user ? (
    <div class="who">
      {staff && (
        <a class="btn btn-ghost staff-link" href={staffHref}>{staffLabel}</a>
      )}
      {/* The identity doubles as the way in to /me, and it says so in words
          rather than relying on the "click your own avatar" convention: until
          that page existed nothing on the site let a person find what they had
          filed, so the link has to be findable. The username moves to the
          title, where it is confirmation rather than something you need — the
          avatar already answers "am I the right account". On a phone the words
          drop and the avatar carries the link, because the two controls have
          to stay tappable inside 390px. */}
      <a class="me" href="/me" title={user.username} aria-label={`Your reports (${user.username})`}>
        {avatar ? (
          <img class="avatar" src={avatar} alt="" width="22" height="22" />
        ) : (
          <span class="avatar avatar-blank" aria-hidden="true" />
        )}
        <span class="name">Your reports</span>
      </a>
      {/* A form, not a link: /auth/logout is POST-only, both because a link
          would 404 against it and because a GET sign-out is trivially
          triggered by any page that can embed an image. */}
      <form method="POST" action="/auth/logout">
        <button class="btn btn-ghost" type="submit">Sign out</button>
      </form>
    </div>
  ) : (
    <a class="btn btn-discord" href={signInHref}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19.3 5.3A16.6 16.6 0 0 0 15.2 4l-.3.6a12.4 12.4 0 0 1 3.7 1.2 12.9 12.9 0 0 0-11-.5l.3-.7A16.5 16.5 0 0 0 4.7 5.3C2.2 9 1.5 12.6 1.9 16.2a16.4 16.4 0 0 0 5 2.5l.6-1a10.7 10.7 0 0 1-1.8-.9l.4-.3a11.7 11.7 0 0 0 10 0l.4.3a10.8 10.8 0 0 1-1.8.9l.6 1a16.3 16.3 0 0 0 5-2.5c.5-4.2-.6-7.8-2.9-10.9ZM8.7 14c-1 0-1.7-.9-1.7-2s.8-2 1.7-2 1.8.9 1.7 2c0 1.1-.8 2-1.7 2Zm6.6 0c-1 0-1.7-.9-1.7-2s.8-2 1.7-2 1.8.9 1.7 2c0 1.1-.8 2-1.7 2Z" />
      </svg>
      <span class="login-text">Sign in</span>
    </a>
  )
}

<style>
  /* Styles moved to src/styles/base.css so view transitions between
     prerendered (sources) and server pages share the same CSS bundle.
     Keeping the block empty preserves the component's CID for any
     remaining scoped selectors, but the visual rules live globally. */
</style>
