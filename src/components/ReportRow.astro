---
import VoteButton from './VoteButton.astro';
import { hostOf } from '../lib/host';
import { getSource, langDir, langLabel } from '../lib/sources';
import {
  CAUSE_LABELS,
  fixedLabel,
  KIND_LABELS,
  relativeAge,
  reportHeadline,
  STAGE_FAILURE,
  stalledLabel,
  STATUS_LABELS,
} from '../lib/format';
import { OPEN_STATUSES, type Report } from '../lib/db/schema';

interface Props {
  report: Report;
  mine?: boolean;
}

const { report: r, mine = false } = Astro.props;

const source = getSource(r.sourceId);
const displayName = source?.name ?? r.proposedName ?? 'Unknown source';

/* Only a report that is still open can be neglected. stalledLabel answers from
   created_at alone, so on the fixed board every row older than 90 days claimed
   to be "waiting 5 months" after it had been dealt with. */
const live = (OPEN_STATUSES as readonly string[]).includes(r.status);
const stalled = live ? stalledLabel(r.createdAt) : null;

/* One phrase instead of a pill and a date that disagreed: the row used to print
   "Fixed" beside the age of the *report*, so something fixed last week read as
   "Fixed · 8mo ago". Where there is a fix date, the status and the date are the
   same fact and are said once. */
const fixed = fixedLabel(r.status, r.statusChangedAt);

// 468 of these came over from the GitHub backlog titled in raw HTTP jargon —
// "Error 503 & Error 444 (Videos)" — and this row is what a search visitor
// lands on. reportHeadline rebuilds those from the stage and cause columns and
// leaves a human-written title alone; the stored title still shows on the
// detail page for cross-referencing the issue.
const headline = reportHeadline(r);
// When it rebuilt the title it built it *out of* stage and cause, so the two
// tags below would then repeat the headline word for word — "Can't browse —
// the site was redesigned" followed by "Can't browse" and "Site redesigned",
// which on a phone costs a whole extra wrapped line to say nothing. Comparing
// against the stored title is how we know it rebuilt: a title a person wrote
// comes back untouched, and for those rows the tags are still the only place
// the row says what broke.
const rebuilt = headline !== r.title;

// Everything the row says, it says in words. Ordering carries the ranking, so
// there is nothing here that needs a legend to read.
const why = !rebuilt && r.cause && r.cause !== 'other' ? CAUSE_LABELS[r.cause] : null;
// "No video" + "No videos" says one thing twice: an extractor failure *is* a
// video failure, so the cause alone carries it.
const redundant = r.cause === 'extractor' && r.stage === 'video';
const whatBroke = !rebuilt && r.stage && !redundant ? STAGE_FAILURE[r.stage] : null;

/* The catalogue answers for a source that exists, the row only for a request —
   the same rule the sync and the report page use, so all three agree. Worth
   saying on the row because a row is not always reached through the board's
   toggle: /me, a source page and a pasted link all show rows unfiltered, and
   until now none of them gave any indication. */
const adult = source ? source.nsfw : r.nsfw;

/* A source request's address, which is the one fact the row was missing: every
   request headline reads "Add <name>", so the row said the name twice and the
   site not at all. Plain text, in the data face, because it is a value. Only
   requests carry `proposed_url`, so this is null on every other row. */
const host = r.proposedUrl ? hostOf(r.proposedUrl) : null;

/* What kind of ask this is, when the row would otherwise not say.
   A feature request carries no stage, no cause and no address, so on the wanted
   board it rendered as a bold source name and a title and nothing else — which
   on a board of source requests reads as "somebody wants AniList added" rather
   than "somebody wants AniList to import their library". The other kinds all
   say what they are through the headline or the tags they already carry. */
const asked = r.kind === 'feature' ? KIND_LABELS.feature : null;
---

<li class="row">
  <VoteButton reportId={r.id} votes={r.votes} mine={mine} closed={!live} />

  <a class="row-main" href={`/report/${r.id}`}>
    <span class="row-title">
      <b class="src" dir={langDir(r.lang)}>{displayName}</b>
      <span class="what">{headline}</span>
    </span>
    <span class="row-meta">
      {fixed ? (
        <span class="status" data-status={r.status}>{fixed}</span>
      ) : (
        r.status !== 'open' && (
          <span class="status" data-status={r.status}>
            {STATUS_LABELS[r.status]}
          </span>
        )
      )}
      {asked && <span class="tag">{asked}</span>}
      {host && <span class="host">{host}</span>}
      {whatBroke && <span class="tag">{whatBroke}</span>}
      {why && <span class="tag">{why}</span>}
      <span>{langLabel(r.lang)}</span>
      {source && <span class="data">v{source.extVersion}</span>}
      {
        /* The fix date has already been said above, so the filing date would be
           a second date on the row with nothing to distinguish it. */
        stalled ? (
          <span class="stalled">{stalled}</span>
        ) : fixed ? null : (
          <span>{relativeAge(r.createdAt)} ago</span>
        )
      }
      {adult && <span class="adult">18+</span>}
      {r.githubIssue && <span class="gh">#{r.githubIssue}</span>}
    </span>
  </a>

</li>

<style>
  .row-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-inline-size: 0;
  }
  .src { font-weight: var(--weight-semi); color: var(--text-primary); white-space: nowrap; }
  .what {
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row-main:hover .what { color: var(--text-primary); }

  .row-meta { gap: var(--space-2); }
  /* Plain words in a quiet box — no colour coding to decode. */
  .tag {
    padding-inline: var(--space-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }
  /* Two words on the row are coloured, and both say what they mean without one.
     18+ is the other; it borrows the same red the dead-source notice uses. */
  .adult {
    color: var(--dead);
    font-weight: var(--weight-medium);
    font-size: var(--text-xs);
  }
  /* Says what it means in words. */
  .stalled { color: var(--stalled); font-weight: var(--weight-medium); }
  /* The domain a request names. Plain text, no colour to decode; it truncates
     rather than pushing the language and the age off the row. */
  .host {
    font-family: var(--font-data);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-inline-size: 22ch;
  }
  .gh { font-family: var(--font-data); font-size: var(--text-xs); color: var(--text-muted); }

  @media (max-width: 640px) {
    .row-title { flex-wrap: wrap; }
    /* 40 of the imported rows have no catalogue match, so their "name" is a
       whole issue title ("Multiple Indonesian Anime Sources Not Working").
       nowrap kept those from being split from their headline and instead ran
       them 45px off the side of a 390px screen, where the overflow was clipped
       and the end of the name simply disappeared. */
    .src { white-space: normal; }
    .what { white-space: normal; }
    /* Version is desktop detail; on a phone it costs a whole wrapped line. */
    .row-meta .data { display: none; }
    .gh { display: none; }
  }
</style>
