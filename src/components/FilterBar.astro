---
import { languageFacets, SOURCES } from '../lib/sources';
import { BOARD_VIEW_COPY, CAUSE_LABELS, type BoardFamily } from '../lib/format';
import type { BoardState } from '../lib/queries';

interface Props {
  family: BoardFamily;
  lang?: string;
  cause?: string;
  nsfw: boolean;
  sort: string;
  /** Which third of the backlog is on screen. */
  state?: BoardState;
  /** How many are open, fixed or closed-without-a-fix, in this family. */
  openCount: number;
  fixedCount: number;
  otherCount: number;
}

const {
  family,
  lang = '',
  cause = '',
  nsfw,
  sort,
  state = 'open',
  openCount,
  fixedCount,
  otherCount,
} = Astro.props;
const langs = languageFacets();
const views = BOARD_VIEW_COPY[family];

// Counted, not typed. This was hardcoded as "108 of 310 sources are marked
// 18+", which was true and would have gone quietly wrong the next time
// `bun run sync:sources` pulled a new catalogue.
const adult = SOURCES.filter((s) => s.nsfw).length;

// 41 languages is past Hick's-law territory for chips, so language is a select
// while the handful of causes stay as one-tap chips.
/* Two of the three open sorts mean nothing once a report is closed: "Longest
   waiting" answers from created_at, which for a closed report is how long ago
   it was filed rather than how long anyone waited, and "Newest" is the same
   question the closed views already answer better. So both closed views offer
   the two orders they can honour — the shared 'fixed' key labelled by what the
   view actually shows. */
const sorts =
  state === 'open'
    ? [
        { key: 'demand', label: 'Most wanted' },
        { key: 'stalled', label: 'Longest waiting' },
        { key: 'recent', label: 'Newest' },
      ]
    : [
        { key: 'demand', label: 'Most wanted' },
        { key: 'fixed', label: state === 'other' ? 'Recently closed' : 'Recently fixed' },
      ];

// The sort that is actually in force, so exactly one chip reads as pressed —
// board() falls the other view's default back to its own, and a chip that
// disagreed with the list under it is worse than no chip at all.
const activeSort =
  state === 'open'
    ? sort === 'fixed'
      ? 'demand'
      : sort || 'demand'
    : sort === 'demand'
      ? 'demand'
      : 'fixed';

const states = (['open', 'fixed', 'other'] as const).map((key) => ({
  key,
  label: views[key].chip,
  count: key === 'open' ? openCount : key === 'fixed' ? fixedCount : otherCount,
}));
---

<form class="filters" method="get" role="search">
  <div class="line primary">
    {/* First control on the bar, because it decides what every other one
        filters. Counts on the chips for the same reason the 18+ chip carries
        one: "Fixed" alone does not say that 468 of these exist. */}
    <div class="segmented states" role="group" aria-label="Open, fixed or other">
      {
        states.map((v) => (
          <button
            class="chip"
            type="submit"
            name="state"
            value={v.key}
            aria-pressed={state === v.key}>
            {v.label} ({v.count})
          </button>
        ))
      }
    </div>

    <label class="sr-only" for="lang">Language</label>
    <select class="select compact" id="lang" name="lang" onchange="this.form.requestSubmit()">
      <option value="">All languages</option>
      {
        langs.map((l) => (
          <option value={l.code} selected={l.code === lang}>
            {l.label} ({l.count})
          </option>
        ))
      }
    </select>

    <div class="segmented sorts" role="group" aria-label="Sort order">
      {
        sorts.map((s) => (
          <button
            class="chip"
            type="submit"
            name="sort"
            value={s.key}
            aria-pressed={activeSort === s.key}>
            {s.label}
          </button>
        ))
      }
    </div>

    <span class="spacer"></span>

    {/* The count is on the chip rather than in a `title`, which a phone never
        shows — and it is the count that makes the control make sense, since
        "18+" alone does not say that a third of the catalogue is hidden behind
        it. Same shape as the language options, which also carry their counts. */}
    <button
      class="chip nsfw"
      type="submit"
      name="nsfw"
      value={nsfw ? '' : '1'}
      aria-pressed={nsfw}
      aria-label={
        nsfw
          ? `Hide the ${adult} sources marked 18+`
          : `Include the ${adult} sources marked 18+, of ${SOURCES.length}`
      }>
      18+ ({adult})
    </button>
  </div>

  {
    family === 'broken' && (
      <div class="line causes">
        <span class="label">Cause</span>
        <button class="chip" type="submit" name="cause" value="" aria-pressed={!cause}>
          Any
        </button>
        {Object.entries(CAUSE_LABELS).map(([key, label]) => (
          <button class="chip" type="submit" name="cause" value={key} aria-pressed={cause === key}>
            {label}
          </button>
        ))}
      </div>
    )
  }

  <!-- Keep the other facets when a chip submits. These sit last on purpose:
       a chip earlier in the form wins, because the server reads the first
       value of a repeated parameter. Without the cause line, changing the sort
       silently reset the cause to Any. -->
  {sort && <input type="hidden" name="sort" value={sort} />}
  {/* Not `state &&`: "open" is the default but it still has to survive a chip
      press, or changing the language on the fixed board would drop you back to
      the open one. */}
  <input type="hidden" name="state" value={state} />
  {nsfw && <input type="hidden" name="nsfw" value="1" />}
  {lang && <input type="hidden" name="lang" value={lang} />}
  {cause && <input type="hidden" name="cause" value={cause} />}
</form>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  .line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  /* Desktop keeps all four on one line. A phone gets three rows and no more,
     because the comment on the cause row below is the constraint for this whole
     bar: filters must not push the list the page exists for below the fold.
     So Open/Fixed pairs with 18+ on the first row, the language select takes a
     full row of its own (a select is easier to hit wide anyway), and the sort
     keeps the third. Explicit orders, since source order cannot express that. */
  .primary .states { order: 0; flex-basis: auto; }
  .primary .spacer { order: 1; }
  .primary .nsfw { order: 2; }
  .primary #lang { order: 3; flex-basis: 100%; }
  .primary .sorts { order: 4; flex-basis: 100%; }
  @media (min-width: 641px) {
    .primary .states { order: 0; }
    .primary #lang { order: 1; flex-basis: auto; margin-inline-start: var(--space-2); }
    .primary .sorts { order: 2; flex-basis: auto; margin-inline-start: var(--space-2); }
    .primary .spacer { order: 3; }
    .primary .nsfw { order: 4; }
  }
  .select.compact {
    inline-size: auto;
    min-inline-size: 11rem;
    max-inline-size: 100%;
    block-size: 26px;
    font-size: var(--text-sm);
    padding-inline: var(--space-2);
  }
  /* Scoped styles are unlayered, so they beat the coarse-pointer utility —
     the select has to opt back in to a touchable height itself. */
  @media (pointer: coarse) {
    .select.compact { block-size: 36px; }
  }
  .segmented {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  /* A control label that wraps mid-word ("Most / wanted") reads as breakage. */
  .segmented .chip { white-space: nowrap; }
  .segmented .chip {
    border-color: transparent;
  }
  /* "18+ (108)" is one label, not two lines. */
  .nsfw { white-space: nowrap; }
  .causes .label {
    margin-inline-end: var(--space-1);
    flex: none;
  }
  /* Phone: one scrollable row instead of three wrapped ones, so the list the
     page exists for is not pushed below the fold by its own filters. */
  @media (max-width: 640px) {
    .causes {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--space-4));
      padding-inline: var(--space-4);
    }
    .causes::-webkit-scrollbar { display: none; }
    /* No scroll-snap: it snapped past the "Cause" label on load, hiding it. */
    .causes .chip { flex: none; }
    .sorts { inline-size: 100%; }
    .segmented .chip { flex: 1; text-align: center; }
    /* Three chips carrying counts, beside the 18+ chip rather than across
       their own row: full width would make each third wide enough to look like
       a button and cost the row the 18+ chip is on. The three no longer fit
       390px alongside it, so the group scrolls sideways instead of wrapping —
       same treatment as .causes above, bleed and hidden scrollbar included. */
    .states {
      flex: 0 1 auto;
      min-inline-size: 0;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline-start: calc(-1 * var(--space-4));
      padding-inline-start: var(--space-4);
    }
    .states::-webkit-scrollbar { display: none; }
    .states .chip { flex: none; }
  }
</style>
