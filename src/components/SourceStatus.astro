---
import ReportRow from './ReportRow.astro';
import { myVotes, reportsForSource } from '../lib/queries';
import { currentUser } from '../lib/auth';
import { OPEN_STATUSES } from '../lib/db/schema';

interface Props {
  sourceId: string;
  sort?: 'demand' | 'recent';
}
const { sourceId } = Astro.props;
const qs = Astro.url.searchParams.get('sort');
const sort = (Astro.props as Props).sort ?? (qs === 'recent' ? 'recent' : 'demand');
const basePath = Astro.url.pathname;

// A server island: the page around it is prerendered and edge-cached, while
// this fragment renders on demand with live data. SvelteKit has no equivalent —
// showing a live count there would force the whole page to be dynamic.
const all = await reportsForSource(sourceId, sort);

/* Being an island is exactly what lets this read the session, and it has to:
   without `mine` every row on a source page rendered un-backed, so tapping the
   vote button on a report you had already backed silently removed your vote
   instead of doing nothing. The board pages have always passed this through;
   this one simply never asked. */
const user = await currentUser(Astro);
const backed = user ? await myVotes(user.id, all.map((r) => r.id)) : new Set<number>();
const open = all.filter((r) => (OPEN_STATUSES as readonly string[]).includes(r.status));
const closed = all.filter((r) => !(OPEN_STATUSES as readonly string[]).includes(r.status));
---

{
  open.length === 0 ? (
    <div class="ok">
      <p class="ok-title">No open reports</p>
      <p class="ok-sub">
        Nobody has reported this source as broken. If it's failing for you, say so. You'll
        be the first.
      </p>
      <a class="btn btn-primary" href={`/new?source=${sourceId}`}>
        Report a problem
      </a>
    </div>
  ) : (
    <section>
      <div class="sort-row">
        <h2 class="label">Open problems</h2>
        <div class="segmented">
          <a class="chip" href={basePath} aria-current={sort === 'demand' ? 'page' : undefined}>Most wanted</a>
          <a class="chip" href={`${basePath}?sort=recent`} aria-current={sort === 'recent' ? 'page' : undefined}>Newest</a>
        </div>
      </div>
      <ol class="rows">
        {open.map((r) => (
          <ReportRow report={r} mine={backed.has(r.id)} />
        ))}
      </ol>
      <a class="btn add" href={`/new?source=${sourceId}`}>
        Something else is broken
      </a>
    </section>
  )
}

{
  closed.length > 0 && (
    <section class="history">
      <h2 class="label">Previously fixed</h2>
      <ol class="rows dim">
        {closed.slice(0, 8).map((r) => (
          <ReportRow report={r} mine={backed.has(r.id)} />
        ))}
      </ol>
    </section>
  )
}

<style>
  .sort-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-block-end: var(--space-2);
  }
  .sort-row .label { margin-block-end: 0; }
  .sort-row .chip[aria-current='page'] {
    background: var(--signal-fill);
    border-color: var(--signal-dim);
    color: var(--signal-ink);
    font-weight: var(--weight-medium);
  }
  /* Not `section + section`: the empty state is a div, so the history section
     ended up flush against it. */
  .history { margin-block-start: var(--space-8); }
  .label { margin-block-end: var(--space-2); }
  .add { margin-block-start: var(--space-3); }
  .ok {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    border-inline-start: 2px solid var(--live);
  }
  .ok-title {
    font-size: var(--text-md);
    font-weight: var(--weight-semi);
    color: var(--live);
  }
  .ok-sub {
    max-inline-size: 52ch;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .history .dim { opacity: 0.62; }
  .history .dim:hover { opacity: 1; }
</style>
