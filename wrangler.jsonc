{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuzono-tracker",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // No `database_id` / `id` on purpose. Wrangler 4.45+ provisions a missing KV
  // namespace or D1 database on deploy and binds it to the Worker, locally as
  // well as in CI. A placeholder id is worse than none: wrangler sends it to
  // the API verbatim and the deploy fails with "not valid".
  //
  // On a repo-connected deploy the generated ids are *not* written back here —
  // they live in the dashboard under the Worker's bindings. That is fine for
  // deploying, but it means remote D1 commands have to address the database by
  // name (see the `db:remote` script) rather than by binding.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuzono-tracker",
      "migrations_dir": "drizzle"
    }
  ],

  "kv_namespaces": [{ "binding": "SESSION" }],

  // Anything in this block is *replaced* on every deploy, so a value set only
  // in the dashboard gets deleted by the next push. That is why the Discord
  // application id lives here rather than there — it is public by nature (it
  // appears in the OAuth URL every visitor sees), so committing it costs
  // nothing and makes the deploy reproducible. Fork this and it is the one
  // value you must change.
  //
  // DISCORD_CLIENT_SECRET and OWNER_DISCORD_ID are deliberately *not* here.
  // They are secrets, and secrets are untouched by a deploy — so they survive
  // pushes for the opposite reason, without being published.
  "vars": {
    "DISCORD_CLIENT_ID": "1540099681827430530",
    "DISCORD_GUILD_ID": "1377136877491982366",
    // Seeds for the editable settings of the same name. Once /admin writes a
    // value it wins; these stay as the defaults a fresh database starts from.
    "MAINTAINER_ROLE_IDS": "",
    "MIN_ACCOUNT_AGE_DAYS": "30",
    "GITHUB_REPO": "yuzono/anime-extensions",
    "PUBLIC_SITE_NAME": "yuzono tracker"
  }
}
