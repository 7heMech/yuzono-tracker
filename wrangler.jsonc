{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuzono-tracker",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // `bunx wrangler d1 create yuzono-tracker` then paste the id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuzono-tracker",
      "database_id": "PLACEHOLDER_RUN_D1_CREATE",
      "migrations_dir": "drizzle"
    }
  ],

  // The Cloudflare adapter provisions this automatically for Astro sessions.
  "kv_namespaces": [{ "binding": "SESSION", "id": "PLACEHOLDER_AUTO_PROVISIONED" }],

  "vars": {
    "DISCORD_CLIENT_ID": "",

    // The one authority the dashboard cannot grant or revoke. Your Discord
    // user id: enable Developer Mode in Discord, then right-click your name →
    // Copy User ID.
    "OWNER_DISCORD_ID": "",

    "DISCORD_GUILD_ID": "1377136877491982366",
    // Seeds for the editable settings of the same name. Once /admin writes a
    // value it wins; these stay as the defaults a fresh database starts from.
    "MAINTAINER_ROLE_IDS": "",
    "MIN_ACCOUNT_AGE_DAYS": "30",
    "GITHUB_REPO": "yuzono/anime-extensions",
    "PUBLIC_SITE_NAME": "yuzono tracker"
  }
}
