# Copy to `.dev.vars` (git-ignored) for local development. The Deploy to
# Cloudflare button reads this same file to know what to ask a deployer for, so
# only genuinely per-install secrets belong here. Anything with a UI in /admin —
# the announcement webhook, staff roles, the account-age gate — is configured
# there and stored in D1, not asked for at deploy time. DISCORD_CLIENT_ID is a
# plain var in wrangler.jsonc, since it is public and must survive deploys.
DISCORD_CLIENT_SECRET= # discord.com/developers/applications → OAuth2 → Reset Secret. Shown once.
OWNER_DISCORD_ID= # Your Discord user id: Settings → Advanced → Developer Mode, then right-click your name → Copy User ID. Grants the /admin dashboard, and is the only authority /admin itself cannot change.
